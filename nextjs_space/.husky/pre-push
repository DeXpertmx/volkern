#!/bin/sh
# Pre-push validation: typecheck + lint:docs + bash fixture + vitest
# Manual error tracking (not set -e) because typecheck has 944 pre-existing
# errors that need gradual fixing. All 4 steps always run; failures are
# reported at the end. Only vitest failure blocks the push.
#
# TODO(tech-debt): restore `set -e` when typecheck is green (0 errors).

FAILED_STEPS=""

# ── Step 1: typecheck (advisory — pre-existing errors, WIP) ──
echo "[pre-push] running npm run typecheck..."
if npm run typecheck; then
    echo "[pre-push]   ✓ typecheck passed"
else
    echo "[pre-push]   ⚠ typecheck has pre-existing errors (tracked as tech-debt)"
    echo "[pre-push]   ⚠ not blocking push, but review output above for NEW errors in your changes"
fi

# ── Step 2: lint:docs (blocking) ──
echo "[pre-push] running npm run lint:docs..."
if npm run lint:docs; then
    echo "[pre-push]   ✓ lint:docs passed"
else
    echo "[pre-push]   ✗ lint:docs FAILED"
    FAILED_STEPS="$FAILED_STEPS lint:docs"
fi

# ── Step 3: fixture (blocking) ──
echo "[pre-push] running bash tests/fence-states.test.sh..."
if bash tests/fence-states.test.sh; then
    echo "[pre-push]   ✓ fixture passed"
else
    echo "[pre-push]   ✗ fixture FAILED"
    FAILED_STEPS="$FAILED_STEPS fixture"
fi

# ── Step 4: vitest (blocking, excludes heavy DB-dependent integration tests) ──
echo "[pre-push] running npx vitest run --bail=5 --exclude accounting-integration..."
if npx vitest run --bail=5 --exclude 'tests/accounting-integration.test.ts'; then
    echo "[pre-push]   ✓ vitest passed"
else
    echo "[pre-push]   ✗ vitest FAILED"
    FAILED_STEPS="$FAILED_STEPS vitest"
fi

# ── Summary ──
if [ -z "$FAILED_STEPS" ]; then
    echo "[pre-push] ✓ all blocking checks passed."
    exit 0
else
    echo "[pre-push] ✗ FAILED steps:$FAILED_STEPS"
    exit 1
fi
