
# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fluy_crm"

# NextAuth.js
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."

# Admin Email
ADMIN_EMAIL="admin@fluy.com"

# Canva Embed API Configuration
NEXT_PUBLIC_CANVA_CLIENT_ID=your_canva_client_id_here

# =============================================
# Hub Social — Meta (Facebook & Instagram) OAuth
# Obtener en: https://developers.facebook.com/
# =============================================
FACEBOOK_APP_ID=your_meta_app_id_here
FACEBOOK_APP_SECRET=your_meta_app_secret_here
META_APP_SECRET=your_meta_app_secret_here

# =============================================
# Data Deletion Callback (Meta Requirement)
# Configura esta URL en el App Dashboard de Meta
# Settings > Data Deletion Request URL
# =============================================
# NEXT_PUBLIC_APP_URL=https://volkern.app

# URL pública de la app (necesaria para el redirect OAuth de Meta)
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com
NEXTAUTH_URL=http://localhost:3000
