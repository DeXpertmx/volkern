# ═══════════════════════════════════════════════════════════════
# Volkern ERP — Variables de Entorno
# Copia este archivo como .env.local y completa los valores
# ═══════════════════════════════════════════════════════════════

# ─── Core ─────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://volkern:volkern_secret@localhost:5432/volkern
DATABASE_URL_ADMIN=postgresql://volkern:volkern_secret@localhost:5432/postgres
NEXTAUTH_SECRET=generar_con: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Clave secreta para autenticar llamadas a endpoints de cron jobs internos
# Los endpoints en app/api/cron/* verifican este valor en el header Authorization: Bearer <CRON_SECRET>
# Generar con: openssl rand -base64 32
CRON_SECRET=
LOG_LEVEL=info

# ─── Docker (docker-compose.yml) ──────────────────────────────
POSTGRES_USER=volkern
POSTGRES_PASSWORD=volkern_secret
POSTGRES_DB=volkern
ALLOW_DB_PUSH=false
SEED_ON_START=false

# ─── AWS / S3 ─────────────────────────────────────────────────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
AWS_ENDPOINT_URL=
S3_ENDPOINT=
NEXT_PUBLIC_CDN_URL=

# ─── AWS SES (Email) ──────────────────────────────────────────
AWS_SES_REGION=eu-north-1
AWS_SES_USER=
AWS_SES_PASSWORD=
EMAIL_FROM=Volkern <noreply@volkern.app>
ADMIN_EMAIL=admin@volkern.app

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Autenticacion / Seguridad ────────────────────────────────
MASTER_KEY=
VAULT_CONTROL_HASH=
TENANT_PEPPER=
CUSTOMER_JWT_SECRET=volkern-customer-portal-secret-2026
ACADEMY_JWT_SECRET=volkern-academy-secret-2026
FISCAL_ENCRYPTION_KEY=
ACCOUNTING_SECRET=volkern-accounting-default-secret-2026
ATTENDANCE_INTEGRITY_SECRET=v0lkern_attendance_secure_v2

# ─── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ESENCIAL_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ESENCIAL_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_PROFESIONAL_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PROFESIONAL_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_INFINITY_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_INFINITY_YEARLY=

# ─── n8n (Workflows) ─────────────────────────────────────────
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# ─── Chatwoot (Omnicanal) ────────────────────────────────────
CHATWOOT_BASE_URL=https://volkern.dimension.expert
CHATWOOT_SUPER_ADMIN_TOKEN=
NEXT_PUBLIC_CHATWOOT_URL=https://volkern.dimension.expert

# ─── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─── Meta / Facebook / Ads ──────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_APP_SECRET=
META_VERIFY_TOKEN=volkern_verify_token
ADS_META_CLIENT_ID=
ADS_META_CLIENT_SECRET=
ADS_GOOGLE_CLIENT_ID=
ADS_GOOGLE_CLIENT_SECRET=
ADS_GOOGLE_DEVELOPER_TOKEN=
ADS_LINKEDIN_CLIENT_ID=
ADS_LINKEDIN_CLIENT_SECRET=
ADS_TIKTOK_CLIENT_ID=
ADS_TIKTOK_CLIENT_SECRET=

# ─── Plaid (Banking) ──────────────────────────────────────────
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=ES
PLAID_REDIRECT_URI=

# ─── Nordigen / GoCardless (Banking) ──────────────────────────
NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=

# ─── Canva ───────────────────────────────────────────────────
NEXT_PUBLIC_CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ─── OpenRouter / AI ─────────────────────────────────────────
OPENROUTER_API_KEY=
GOOGLE_AI_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GEMMA_MODEL=gemini-flash-latest
AI_SKILL_HANDLER_API_KEY=

# ─── Evolution API (WhatsApp) ────────────────────────────────
EVOLUTION_API_URL=https://evo.abacus.ai
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE_NAME=

# ─── Resend (Email transaccional) ────────────────────────────
RESEND_API_KEY=

# ─── Google OAuth / Calendar ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_FONTS_APIKEY=
GCAL_SYNC_SECRET=volkern-gcal-sync-2024

# ─── Cloudflare DNS ──────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
ROOT_DOMAIN=volkern.app

# ─── OneSignal (Push Notifications) ──────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Namecrane / Smartermail ─────────────────────────────────
NAMECRANE_API_KEY=
SMARTERMAIL_API_URL=https://eu1.workspace.org
SMARTERMAIL_ADMIN_USER=
SMARTERMAIL_ADMIN_PASSWORD=

# ─── AEAT (Agencia Tributaria) ───────────────────────────────
AEAT_CERT_P12_BASE64=
AEAT_CERT_PASSWORD=
AEAT_ENV=development

# ─── Apprise (Notificaciones) ────────────────────────────────
APPRISE_API_KEYS=
APPRISE_LOG_LEVEL=INFO

# ─── MCP Server ───────────────────────────────────────────────
VOLKERN_API_URL=https://volkern.app/api
VOLKERN_API_KEY=

# ─── Nexus Hub ────────────────────────────────────────────────
ENCRYPTION_KEY=

# ─── Auditoria Externa ───────────────────────────────────────
EXTERNAL_AUDIT_LOG_URL=

# ─── App Movil (Expo) ────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# ─── Bundle Analyzer ──────────────────────────────────────────
ANALYZE=false
# Partner API Rate Limiting (Upstash Redis REST API, edge-compatible)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token-here
UPSTASH_SALT=volkern_partner_default_salt
