  tenantId        String
  targetDate      DateTime
  expectedInflow  Float
  expectedOutflow Float
  netBalance      Float
  riskLevel       String   // 'LOW', 'MEDIUM', 'HIGH'
  confidence      Float
  metadata        Json?    // { scenarios: [], drivers: [] }
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([targetDate])
}

model StrategicRecommendation {
  id              String   @id @default(cuid())
  tenantId        String
  type            String   // 'UPSELL', 'CHURN_RISK', 'COST_REDUCTION', 'PIVOT'
  title           String
  description     String   @db.Text
  impact          String   // 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'
  priority        Int      @default(1)
  status          String   @default("PENDING") // 'PENDING', 'ACCEPTED', 'REJECTED', 'IMPLEMENTED'
  evidence        Json?    // { dataPoints: [] }
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

model ExecutiveAlert {
  id              String   @id @default(cuid())
  tenantId        String
  severity        String   // 'INFO', 'WARNING', 'CRITICAL'
  message         String   @db.Text
  category        String   // 'PROFITABILITY', 'CASHFLOW', 'SLA', 'GROWTH'
  isRead          Boolean  @default(false)
  actionLink      String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

model Asset {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  category        String   // 'HARDWARE', 'SOFTWARE', 'VEHICLE', 'LICENSE', 'OTHER'
  model           String?
  serialNumber    String?  @unique
  status          String   @default("AVAILABLE") // 'AVAILABLE', 'ASSIGNED', 'MAINTENANCE', 'RETIRED'
  purchaseDate    DateTime?
  purchasePrice   Float?
  warrantyEnd     DateTime?
  renewalDate     DateTime?
  metadata        Json?    @default("{}") // Specs, details
  
  assignments     AssetAssignment[]
  maintenanceLogs AssetMaintenance[]
  events          AssetEvent[]

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([category])
  @@map("erp_assets")
