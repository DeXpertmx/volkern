// ─── Inferencia de moneda del tenant ───────────────────────────────
// Trazabilidad programática de POR QUÉ cada tenant tiene su moneda
// actual. Permite al superadmin listar tenants con moneda heredada
// del default MXN para revisar manualmente.
//
// Valores:
//   EXPLICIT     — el operador eligió moneda vía CLI flag / API body / PATCH manual.
//   USER_PROMPT  — seleccionado por el usuario en el prompt interactivo (TTY).
//   IMPORT_AUTO  — auto-set por el helper post-import tras el primer batch.
//   FALLBACK     — default del schema (MXN), nunca establecido explícitamente.
//
enum MonedaInferenciaSource {
  EXPLICIT
  USER_PROMPT
  IMPORT_AUTO
  FALLBACK
}

// ─── Aseguradora ──────────────────────────────────────────────────────────────

model Aseguradora {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre          String
  nif             String?
  direccion       String?
  telefono        String?
  email           String?
  web             String?

  // ─── Identificación Legal y Fiscal (Bloque 1) ─────────────
  razonSocial     String?
  nombreComercial String?
  codigoPostal    String?
  provincia       String?
  pais            String?
  regimenFiscal   String?

  // ─── Regulación y Licencias (Bloque 2) ────────────────────
  numeroRegistro              String?
  ramosAutorizados           Json?   // string[] — ramos de negocio autorizados (Vida, Salud, Autos...)
  fechaVigenciaLicenciaInicio DateTime?
  fechaVigenciaLicenciaFin    DateTime?

  // ─── Contacto y Representación Legal (Bloque 3) ───────────
  representanteLegal   Json?   // { nombre, documento, cargo }
  mesaEntradas         String? // email institucional para notificaciones/regulatorio
  contactosOperativos  Json?   // [{ cargo, nombre, email, telefono }]

  // ─── Parámetros Operativos y Comerciales (Bloque 4) ────────
  modelosComision      Json?   // [{ nombre, tipo, pct, aplicaA }]
  condicionesPago      Json?   // { diasGracia, politicaCancelacion, requiereAnticipo }
  limitesSuscripcion   Json?   // { montoMaximoAutomatico, moneda, requiereAprobacionManual }
  gestionSiniestros    Json?   // { slaRespuestaHoras, limiteIndemnizacion, tipoLimite, deducible }

  // ─── Configuración Financiera y Bancaria (Bloque 5) ────────
  cuentasBancarias     Json?   // [{ banco, tipoCuenta, numeroCuenta, clabe, iban, swift, moneda }]
  monedaBase           String?
  monedaLiquidacion    String?

  // ─── Integración Técnica y Seguridad (Bloque 6) ────────────
  integracionApi       Json?   // { apiKey, oauth, endpoints, formatos, certificados }

  notas           String?
  codigoExterno   String?
  activa          Boolean           @default(true)

  productos       ProductoSeguro[]
  polizas         Poliza[]
  siniestros      Siniestro[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([tenantId, nombre])
  @@index([tenantId])
  @@map("insurance_aseguradoras")
}

// ─── ProductoSeguro ───────────────────────────────────────────────────────────

model ProductoSeguro {
