  contractUrlEncrypted   String?
  encryptionKeyId        String?
  isActive               Boolean                   @default(true)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  // COMPLIANCE (LOPDGDD Art. 88): fecha en que el empleado aceptó la cláusula de
  // tratamiento de geolocalización. null = no informado (RGPD Art. 6.1.c obligación
  // de informar antes del primer tratamiento). Si Tenant.attendanceRules.blockIfNotNoticed=true,
  // el servicio rechaza nuevos punches de empleados con noticeAcknowledgedAt=null.
  noticeAcknowledgedAt   DateTime?
  noticeVersionAccepted  String?
  // Lista de políticas aceptadas, e.g. ["v1-2026-gps-only", "v1-2024-payroll-vault"].
  // JSON para añadir futuras cláusulas sin migración de schema.
  acceptedPolicies       Json?                     @default("[]")
  allowedTeleworkLat     Float?
  allowedTeleworkLng     Float?
  isTeleworkAllowed      Boolean                   @default(false)
  teleworkRadius         Int                       @default(100)
  baseGPSLat             Float?
  baseGPSLng             Float?
  demographicGroup       String?
  externalEmployeeId     String?
  // COMPLIANCE-NOTE: faceVector (biometric face embedding) retired — RGPD Art. 9 + EDPB 8/2020.
  // faceVector             String?   // intentionally removed; do not reintroduce.
  homeOfficeLat          Float?
  homeOfficeLng          Float?
  bankDetailsEncrypted   String?
  governmentIdEncrypted  String?
  vacationQuota          Int                       @default(22)
  vacationUsed           Int                       @default(0)
  irpfrate               Float?                    @default(15)
  salary                 Decimal?                  @default(0) @db.Decimal(10, 2)
  ssrate                 Float?                    @default(6.35)
