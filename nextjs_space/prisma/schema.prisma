model MarketObservation {
  id              String   @id @default(cuid())
  tenantId        String
  category        String   // 'TECHNOLOGY', 'REGULATION', 'CONSUMER_BEHAVIOR'
  observation     String   @db.Text
  trendDirection  String   // 'RISING', 'STABLE', 'DECLINING'
  confidence      Float
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@map("erp_market_observations")
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  content     String   @db.Text
  category    String   // 'POLICY', 'SOP', 'CULTURE', 'TECHNICAL'
  tags        String[]
  vectorId    String?  // Referencia externa para búsqueda semántica si aplica
  isPublic    Boolean  @default(false) // Para base de conocimiento de clientes
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@map("erp_knowledge_articles")
}

model UserGuidanceLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  hub         String   // El módulo donde pidió ayuda
  query       String
  response    String   @db.Text
  wasHelpful  Boolean?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@map("erp_user_guidance_logs")
}
