  quiz                Quiz                  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  respuestas          RespuestaEstudiante[]

  @@index([estudianteId])
  @@index([quizId])
}

model RespuestaEstudiante {
  id              String      @id @default(cuid())
  intentoId       String
  preguntaId      String
  respuesta       String
