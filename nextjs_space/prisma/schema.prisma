  tenant                    Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inscripciones             Inscripcion[]
  modulos                   Modulo[]
  reviews                   Review[]
  AcademyPath               AcademyPath[] @relation("PathCourses")

  @@index([tenantId])
  @@index([publicado])
  @@index([categoria])
  @@index([urlSlug])
  @@index([catalogoItemId])
}

model Modulo {
  id                 String    @id @default(cuid())
  cursoId            String
  titulo             String
  descripcion        String?
  orden              Int
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt
