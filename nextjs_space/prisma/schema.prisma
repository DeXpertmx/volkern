  comunidadActiva           Boolean       @default(false)
  gamificacionActiva        Boolean       @default(false)
  puntosPorLeccion          Int           @default(10)
  bundlesIncluidos          BundleCurso[]
  certificados              Certificado[]
  comentarios               Comentario[]
  cupones                   Cupon[]
