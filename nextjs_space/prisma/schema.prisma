enum AccountType {
  PERSONAL
  BUSINESS
  AGENCY
}

enum BenefitCategory {
  TRANSPORT
  MEAL
  EDUCATION
  HOUSING
  OTHER
}

enum BenefitFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FiscalType {
  AUTONOMO
  EMPRESA
  CLIENTE_EXTRANJERO
}

// --- VOLKERN HUB CONTABLE E INMUTABILIDAD ---

enum AccountingEntryStatus {
  DRAFT
  POSTED // Asiento firme
  RECONCILED // Conciliado con banco
  VOIDED // Anulado (los asientos nunca se borran, se anulan con un contra-asiento)
}

enum TaxType {
  IVA_REPERCUTIDO
  IVA_SOPORTADO
  IRPF_RETENCION
  IS_PAGO_CUENTA
}

model AccountingAccount {
  id       String           @id @default(cuid())
  tenantId String
  code     String // Ej: "430001"
  name     String // Ej: "Clientes Nacionales"
  type     String // Activo, Pasivo, Gasto, Ingreso
  balance  Decimal          @default(0)
  entries  AccountingLine[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("accounting_accounts")
}

model AccountingEntry {
  id          String                @id @default(cuid())
  tenantId    String
  date        DateTime              @default(now())
  description String
  reference   String? // ID de la Factura, Nómina o Gasto que originó esto
  status      AccountingEntryStatus @default(POSTED)

  // Seguridad e Inmutabilidad (Protocolo Trust)
  previousHash String? // Hash del asiento anterior para cadena inalterable
  entryHash    String // HMAC-SHA256(date + lines + previousHash)
  sealedBy     String? // Firma digital del usuario/sistema que cerró el asiento

  lines           AccountingLine[]
  taxImpact       TaxRecord[]
  reconciliations BankReconciliation[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("accounting_entries")
}

model AccountingLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Decimal @default(0)
  credit    Decimal @default(0)

  entry   AccountingEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("accounting_lines")
}

model BankConnection {
  id            String    @id @default(cuid())
  tenantId      String
  provider      String // Ej: "Gocardless", "SaltEdge"
  providerId    String // ID externo de la conexión (Plaid Item ID)
  accessToken   String? // Token de acceso (encriptado idealmente)
  institutionId String? // ID de la institución bancaria
  bankName      String
  lastSync      DateTime?
  status        String // ACTIVE, DISCONNECTED
  metadata      Json?     @default("{}")

  transactions BankTransaction[]
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("accounting_bank_connections")
}

model BankTransaction {
  id               String   @id @default(cuid())
  bankConnectionId String
  date             DateTime
  description      String
  amount           Decimal
  reference        String? // Referencia bancaria original
  isReconciled     Boolean  @default(false)

  reconciliations BankReconciliation[]
  bankConnection  BankConnection       @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@unique([bankConnectionId, reference])
  @@map("accounting_bank_transactions")
}

model BankReconciliation {
  id              String   @id @default(cuid())
  entryId         String
  transactionId   String
  matchedBy       String // "SYSTEM", "GEMMA_AI", "USER_ID"
  confidenceScore Float? // Score de confianza de Gemma
  createdAt       DateTime @default(now())

  entry       AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("accounting_reconciliations")
}

model TaxRecord {
  id          String  @id @default(cuid())
  tenantId    String
  entryId     String
  type        TaxType
  baseAmount  Decimal
  taxRate     Decimal
  taxAmount   Decimal
  periodMonth Int
  periodYear  Int
  isFiled     Boolean @default(false) // Si se ha presentado ya el modelo oficial

  entry  AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("accounting_tax_records")
}

model AccountingPeriod {
  id          String    @id @default(cuid())
  tenantId    String
  year        Int
  month       Int // 1-12 o 0 para cierre anual
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
  closingHash String? // Hash final del periodo (Snapshot de integridad)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, month])
  @@map("accounting_periods")
}

model ChatChannel {
  id            String             @id @default(cuid())
  tenantId      String
  name          String
  type          ChatChannelType    @default(public)
  isLocked      Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]
  subscriptions ChatSubscription[]

  @@index([tenantId])
  @@index([type])
}

model ChatMessage {
  id              String            @id @default(cuid())
  tenantId        String
  channelId       String
  senderId        String? // Null for system messages
  content         String
  isSystemMessage Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  editedAt        DateTime?
  deletedAt       DateTime?
  metadata        Json?             @default("{}")
  channel         ChatChannel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender          User?             @relation(fields: [senderId], references: [id])
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attributions    ChatAttribution[]

  @@index([tenantId])
  @@index([channelId])
  @@index([senderId])
  @@index([createdAt])
}

model ChatSubscription {
  id         String      @id @default(cuid())
  tenantId   String
  userId     String
  channelId  String
  lastReadAt DateTime    @default(now())
  isPinned   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([tenantId])
  @@index([userId])
  @@index([channelId])
}

model ChatAttribution {
  id         String      @id @default(cuid())
  tenantId   String
  messageId  String
  entityType String // Invoice, Deal, Project, Ticket, GemmaAlert
  entityId   String
  createdAt  DateTime    @default(now())
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([messageId])
  @@index([entityType, entityId])
}

model GemmaRequest {
  id        String          @id @default(cuid())
  tenantId  String
  event     String          @default("system.event")
  payload   Json
  createdAt DateTime        @default(now())
  responses GemmaResponse[]
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([event])
}

model GemmaResponse {
  id               String       @id @default(cuid())
  tenantId         String
  gemmaRequestId   String
  suggestionId     String?      @unique
  type             String // reconciliation_suggestion, integrity_alert, summary, action_recommendation
  message          String
  confidence       Float        @default(0)
  evidence         Json?
  suggestedActions Json?
  payload          Json // Raw output from Gemma
  status           String       @default("pending") // pending, executed, dismissed
  createdAt        DateTime     @default(now())
  request          GemmaRequest @relation(fields: [gemmaRequestId], references: [id], onDelete: Cascade)
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([gemmaRequestId])
  @@index([type])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CLIENT
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SlaState {
  ON_TIME
  AT_RISK
  BREACHED
}

model SupportTicket {
  id              String               @id @default(cuid())
  tenantId        String
  subject         String
  description     String               @db.Text
  status          SupportTicketStatus  @default(OPEN)
  priority        SupportTicketPriority @default(MEDIUM)
  creatorId       String
  assignedId      String?
  source          String               // 'MANUAL', 'CHAT', 'GEMMA', 'SYSTEM'
  
  // Relaciones Connect
  channelId       String?  // Canal de Connect vinculado a este ticket
  entityType      String?  // Ej: 'INVOICE'
  entityId        String?
  
  // SLA Management
  slaPriority     SupportTicketPriority? 
  slaStartedAt    DateTime?            @default(now())
  slaDueAt        DateTime?
  slaBreachAt     DateTime?
  slaState        SlaState?            @default(ON_TIME)
  escalatedTo     String?              // userId o role
  acknowledgeAt   DateTime?            // Para medir MTTD
  
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  resolvedAt      DateTime?

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator         User                 @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee        User?                @relation("TicketAssignee", fields: [assignedId], references: [id])
  timeline        TicketTimeline[]

  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model TicketTimeline {
  id        String   @id @default(cuid())
  ticketId  String
  actorId   String?  // ID de Usuario o null si es GEMMA/SYSTEM
  actorType String   @default("USER") // 'USER', 'GEMMA', 'SYSTEM'
  action    String   // 'STATUS_CHANGE', 'COMMENT', 'ASSIGNMENT', 'SLA_WARNING', 'SLA_BREACH'
  note      String?  @db.Text
  metadata  Json?    @default("{}") // SLA capture, etc.
  slaState  SlaState?  // Captura el estado del SLA en el momento del evento
  createdAt DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
  @@map("support_ticket_timelines")
}

model StrategySnapshot {
  id              String   @id @default(cuid())
  tenantId        String
  periodStart     DateTime
  periodEnd       DateTime
  metrics         Json     // { mrr, churn, totalRevenue, totalExpenses, margin, customerAcquisitionCost, ltv }
  confidence      Float    @default(1.0)
  generatedBy     String   @default("SYSTEM")
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
}

model ProfitabilityRecord {
  id              String   @id @default(cuid())
  tenantId        String
  entityType      String   // 'CLIENT', 'PROJECT', 'SERVICE'
  entityId        String
  revenue         Float
  directCosts     Float
  operationalCost Float    // Derived from Support/Taskforce hours
  margin          Float
  roi             Float
  score           Float    // 0-100 rating
  recommendation  String?  @db.Text
  period          String   // '2024-Q1', '2024-04'
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([entityId])
}

model CashflowProjection {
