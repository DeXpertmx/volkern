generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Base shadow para `migrate dev` (ver docs/PRISMA-BASELINE.md).
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String                     @id @default(cuid())
  name                    String?
  email                   String                     @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  estado                  String                     @default("activo")
  fechaAceptacion         DateTime?
  fechaInvitacion         DateTime?
  invitadoPor             String?
  roleId                  String?
  // Vínculo con el contacto del CRM cuando este usuario ES el huésped de una
  // reserva (rol Huésped). El módulo filtra por él: sin vínculo no ve ninguna,
  // y nunca las de la cuenta entera.
  contactId               String?
  telefono                String?
  tenantId                String?
  timezone                String                     @default("America/Mexico_City")
  tokenInvitacion         String?                    @unique
  tokenInvitacionExpiry   DateTime?
  metadata                Json?                      @default("{}")
  resetToken              String?                    @unique
  resetTokenExpiry        DateTime?
  bookingBio              String?
  bookingEnabled          Boolean                    @default(false)
  bookingSlug             String?
  // Único POR TENANT (no global): dos tenants pueden usar el mismo slug de booking.
  // Las lookups públicos filtran por el subdominio y hacen fallback global para QRs antiguos.
  bookingTitle            String?
  isTwoFactorEnabled      Boolean                    @default(false)
  twoFactorCode           String?
  twoFactorExpires        DateTime?
  tokenVersion            Int                        @default(0)
  accounts                Account[]
  auditLogs               AuditLog[]
  chatMessages            ChatMessage[]
  chatSubscriptions       ChatSubscription[]
  citasAsignadas          Cita[]                     @relation("CitaAssignee")
  interaccionesCreadas    Interaction[]              @relation("InteractionCreator")
  leadsAsignados          Lead[]                     @relation("LeadAssignee")
  notasCreadas            Note[]                     @relation("NoteCreator")
  sessions                Session[]
  tareasAsignadas         Task[]                     @relation("TaskAssignee")
  role                    Role?                      @relation(fields: [roleId], references: [id])
  tenant                  Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacto                Contact?                   @relation("UserContacto", fields: [contactId], references: [id], onDelete: SetNull)
  whatsappInstances       UserWhatsAppInstance[]     @relation("UserWhatsAppInstances")
  agent_skill_logs        agent_skill_logs[]
  apiKeys                 ApiKey[]
  apiRequestLogs          ApiRequestLog[]
  comisiones              Comision[]                 @relation("Comisiones")
  captacionesCreadas      Captacion[]                @relation("CaptacionesCreadas")
  contratosCreadoPor      Contrato[]                 @relation("ContratosCreadoPor")
  contratosFirmadoPor     Contrato[]                 @relation("ContratosFirmadoPor")
  cotizacionesCreadaPor   Cotizacion[]               @relation("CotizacionesCreadaPor")
  actividadesDeals        DealActivity[]             @relation("DealActivities")
  archivosDeals           DealAttachment[]           @relation("DealAttachments")
  dealsAsignados          Deal[]                     @relation("DealsAsignados")
  digitalCard             DigitalCard?               @relation("UserDigitalCard")
  employee                Employee?
  expensesCreated         Expense[]                  @relation("ExpenseCreator")
  expenseInboxDocuments   ExpenseInboxDocument[]
  erp_sales_order_audits  erp_sales_order_audits[]
  stockMovements          StockMovement[]            @relation("StockMovementUser")
  googleCalendar          GoogleCalendarIntegration? @relation("UserGoogleCalendar")
  inAppNotifications      InAppNotification[]
  incomingWebhooks        IncomingWebhook[]
  leadAttachments         LeadAttachment[]           @relation("LeadAttachments")
  marketingAuditLogs      MarketingAuditLog[]
  metasVenta              MetaVenta[]                @relation("MetasVenta")
  ordenesVentaCreadoPor   OrdenVenta[]               @relation("OrdenVentaCreadoPor")
  comprasCreadas          Compra[]                   @relation("CompraCreadaPor")
  outgoingWebhooks        OutgoingWebhook[]
  componentesCreados      PageComponent[]            @relation("ComponentCreator")
  paginasCreadas          Page[]                     @relation("PageCreator")
  plaudernAutoAssignments PlaudernIntegration[]      @relation("PlaudernAutoAssignUser")
  salesPlaybookEntries    SalesPlaybookEntry[]
  assignedTickets         SupportTicket[]            @relation("TicketAssignee")
  createdTickets          SupportTicket[]            @relation("TicketCreator")
  trainingSessions        TrainingSession[]
  contestsSales           SalesContestEdition[]
  equalityComplaints      EqualityComplaint[]
  disponibilidad          Disponibilidad[]
  ausencias               Ausencia[]
  polizasCreadas          Poliza[]                          @relation("PolizaCreator")
  siniestrosReportados    Siniestro[]                       @relation("SiniestroReporter")
  renovacionesAsignadas   Renovacion[]                      @relation("RenovacionAgente")
  oportunidadesAsignadas  OportunidadComercial[]            @relation("OportunidadAgente")
  importLogsInsurance     InsuranceImportLog[]              @relation("ImportLogCreator")

  @@index([tenantId])
  @@index([roleId])
  @@index([contactId])
  @@index([email])
  @@index([estado])
  @@unique([tenantId, bookingSlug])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TenantWhatsAppInstance {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  instanceName  String    @unique
  phoneNumber   String?
  status        String    @default("disconnected")
  qrCode        String?
  qrCodeExpiry  DateTime?
  profileName   String?
  profilePicUrl String?
  totalMensajes Int       @default(0)
  ultimoMensaje DateTime?
  fechaConexion DateTime?
  fechaCreacion DateTime  @default(now())
  fechaEdicion  DateTime  @updatedAt

  tenant Tenant @relation("TenantBusinessWhatsApp", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model UserWhatsAppInstance {
  id            String    @id @default(cuid())
  userId        String
  tenantId      String
  instanceName  String    @unique
  phoneNumber   String?
  status        String    @default("disconnected")
  qrCode        String?
  qrCodeExpiry  DateTime?
  profileName   String?
  profilePicUrl String?
  totalMensajes Int       @default(0)
  ultimoMensaje DateTime?
  fechaConexion DateTime?
  fechaCreacion DateTime  @default(now())
  fechaEdicion  DateTime  @updatedAt
  tenant        Tenant    @relation("TenantWhatsAppInstances", fields: [tenantId], references: [id], onDelete: Cascade)
  user          User      @relation("UserWhatsAppInstances", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([instanceName])
  @@index([status])
}

model PlatformWhatsAppInstance {
  id            String    @id @default(cuid())
  instanceName  String    @unique
  phoneNumber   String?
  status        String    @default("disconnected")
  qrCode        String?
  qrCodeExpiry  DateTime?
  profileName   String?
  profilePicUrl String?
  totalMensajes Int       @default(0)
  ultimoMensaje DateTime?
  fechaConexion DateTime?
  fechaCreacion DateTime  @default(now())
  fechaEdicion  DateTime  @updatedAt

  @@index([status])
  @@map("platform_whatsapp_instances")
}

model WhatsAppDeliveryFailure {
  id                     String    @id @default(cuid())
  tenantId               String
  instanceName           String?
  chatwootAccountId      Int
  chatwootConversationId Int // display_id de la conversación en el hub
  contactoNombre         String?
  telefono               String?
  emailContacto          String?
  empresa                String?
  mensajeFallido         String?
  notaAgente             String?
  estado                 String    @default("pendiente") // pendiente | resuelto
  resueltoPor            String?
  resueltoDesde          String? // app | notificacion (auditoría de quién/cómo se resolvió)
  fechaResolucion        DateTime?
  fechaCreacion          DateTime  @default(now())
  fechaEdicion           DateTime  @updatedAt

  @@index([tenantId, estado])
  @@index([chatwootConversationId])
  @@index([fechaCreacion])
}

