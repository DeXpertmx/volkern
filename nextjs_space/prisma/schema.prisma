model ApiKey {
  id                String                   @id @default(cuid())
  tenantId          String
  userId            String
  nombre            String
  descripcion       String?
  keyHash           String                   @unique
  prefix            String
  scopes            String[]                 @default([])
  activo            Boolean                  @default(true)
  expiraEn          DateTime?
  ultimoUso         DateTime?
  totalUsos         Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiRequestLogs    ApiRequestLog[]
  webhookDeliveries PartnerWebhookDelivery[]

  // ─── Partner Integration Developer Console ─────────
  partnerLabel    String? // etiqueta humana del partner (ERP, POS, e-commerce)
  webhookUrl      String? // null = sin webhook outbound
  webhookSecret   String? // HMAC shared secret (plaintext, partner también lo necesita para verificar)
  webhookEvents   String[]  @default([]) // ["invoice.accepted", "invoice.rejected", ...]
  webhookEnabled  Boolean   @default(false)
  rateLimitPerMin Int? // override (null = heredar cuota del plan)
  revokedAt       DateTime?
  revokedReason   String?

  @@index([tenantId])
  @@index([userId])
  @@index([keyHash])
  @@index([activo])
  @@index([webhookEnabled])
  @@map("api_keys")
}

/// Log de cada request autenticada con API key — fire-and-forget (no añade latencia)
model ApiRequestLog {
  id                String           @id @default(cuid())
  tenantId          String
  userId            String?
  apiKeyId          String?
  requestId         String           @unique // correlación con logs del partner
  method            String
  path              String
  statusCode        Int
  latencyMs         Int
  ipAddress         String?
  userAgent         String?
  occurredAt        DateTime         @default(now())
  errorMessage      String?
  metadata          Json?
  apiKey            ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  IncomingWebhook   IncomingWebhook? @relation(fields: [incomingWebhookId], references: [id])
  incomingWebhookId String?

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([apiKeyId, occurredAt(sort: Desc)])
  @@index([statusCode])
  @@map("api_request_logs")
}

/// Cada delivery outbound hacia un partner (eventos de estado AEAT/etc)
model PartnerWebhookDelivery {
  id                String           @id @default(cuid())
  tenantId          String
  apiKeyId          String
  eventType         String // "invoice.accepted" | "invoice.rejected" | ...
  eventId           String           @unique // idempotencia delivery
  payload           Json             @db.Json
  signature         String // "sha256=<hex>" del body firmado
  targetUrl         String
  status            String           @default("pending") // pending | sent | failed | retrying
  attempts          Int              @default(0)
  maxAttempts       Int              @default(5)
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  responseStatus    Int?
  responseBody      String? // truncado 4KB
  responseHeaders   Json?
  errorMessage      String?
  createdAt         DateTime         @default(now())
  completedAt       DateTime?
  apiKey            ApiKey           @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  IncomingWebhook   IncomingWebhook? @relation(fields: [incomingWebhookId], references: [id])
  incomingWebhookId String?

  @@index([tenantId, status, nextAttemptAt])
  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([eventType])
  @@map("partner_webhook_deliveries")
}

