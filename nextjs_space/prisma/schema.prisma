model AttendanceRules {
  id                  String  @id @default(cuid())
  tenantId            String  @unique
  // COMPLIANCE-NOTE: Selfie/biometric capture was removed (RGPD Art. 9 risk).
  //   The only signal we now collect is GPS at the moment of the punch (RGPD Art. 6).
  requireGPS          Boolean @default(true)
  gracePeriodMinutes  Int     @default(3)
  antiSpoofingLevel   String  @default("HIGH")
  // Minimum seconds between two punches from the same employee (anti brute-force / accidental double-tap).
  minPunchIntervalSec Int     @default(30)
  // Velocidad máxima plausible (km/h) entre dos marcajes consecutivos del mismo empleado.
  // 250 km/h cubre一辆輛 de emergencia + Alta Velocidad Española (AVE ~300 km/h punta).
  // Para trabajos multi-site nacionales puede bajarse. Default 250.
  maxTravelKmh        Int     @default(250)
  // Hard retention cap (RGPD Art. 5.1.e). Defaults to 4 years (RD-Ley 8/2010 + LISOS laboral prescription).
  retentionDays       Int     @default(1460)
  // Notice version the employee last acknowledged (LOPDGDD Art. 88 transparency requirement).
  noticeVersion       String  @default("v1-2026-gps-only")
  // Bloquea el marcaje si el empleado no ha firmado la cláusula de tratamiento GPS.
  // Default false en MVP; un DPO debería activarlo por tenant tras firma masiva.
  blockIfNotNoticed   Boolean @default(false)
  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  tenantId     String
  key          String // valor crudo de `Idempotency-Key` header (RFC Stripe-style)
  scope        String // e.g. "attendance.punch" para namespaces futuros
  responseJson Json // respuesta cacheada para reintentos idénticos
  createdAt    DateTime @default(now())
  expiresAt    DateTime // TTL: 24h para attendance (otros scopes pueden usar TTL distinto)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // UNIQUE constraint prevents race conditions: dos punches concurrentes
  // con el mismo `(tenantId, key)` chocan en DB y el segundo se rechaza con P2002.
  @@unique([tenantId, scope, key])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("erp_idempotency_keys")
}

