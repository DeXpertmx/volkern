model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  tenantId      String
  type          String
  timestamp     DateTime @default(now())
  method        String
  locationLat   Float?
  locationLng   Float?
  integrityHash String
  // COMPLIANCE-NOTE (RGPD/LOPDGDD, Julio 2026): evidenceUrl + biometric challenges retired.
  // Attendance scheme now keeps ONLY GPS point + HMAC integrity chain (Veri*Factu style).
  isAnomaly     Boolean  @default(false)
  anomalyType   String?
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([timestamp])
  // COMPLIANCE-NOTE: composite index para que el cron `app/api/cron/cleanup-attendance`
  //   haga `DELETE WHERE tenantId=X AND timestamp<Y` con range scan O(log n)
  //   en lugar de BitmapAnd entre dos índices individuales.
  @@index([tenantId, timestamp])
  @@map("erp_attendance_logs")
}

