generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatChannelType {
  system
  public
  private
  project
  deal
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String                     @id @default(cuid())
  name                    String?
  email                   String                     @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  estado                  String                     @default("activo")
  fechaAceptacion         DateTime?
  fechaInvitacion         DateTime?
  invitadoPor             String?
  roleId                  String?
  telefono                String?
  tenantId                String?
  timezone                String                     @default("America/Mexico_City")
  tokenInvitacion         String?                    @unique
  metadata                Json?                      @default("{}")
  resetToken              String?                    @unique
  resetTokenExpiry        DateTime?
  twoFactorCode           String?
  twoFactorExpires        DateTime?
  isTwoFactorEnabled      Boolean                    @default(false)
  tokenVersion            Int                        @default(0)
  bookingBio              String?
  bookingEnabled          Boolean                    @default(false)
  bookingSlug             String?                    @unique
  bookingTitle            String?
  accounts                Account[]
  auditLogs               AuditLog[]
  citasAsignadas          Cita[]                     @relation("CitaAssignee")
  interaccionesCreadas    Interaction[]              @relation("InteractionCreator")
  leadsAsignados          Lead[]                     @relation("LeadAssignee")
  notasCreadas            Note[]                     @relation("NoteCreator")
  sessions                Session[]
  tareasAsignadas         Task[]                     @relation("TaskAssignee")
  role                    Role?                      @relation(fields: [roleId], references: [id])
  tenant                  Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappInstances       UserWhatsAppInstance[]     @relation("UserWhatsAppInstances")
  agent_skill_logs        agent_skill_logs[]
  apiKeys                 ApiKey[]
  comisiones              Comision[]                 @relation("Comisiones")
  contratosCreadoPor      Contrato[]                 @relation("ContratosCreadoPor")
  contratosFirmadoPor     Contrato[]                 @relation("ContratosFirmadoPor")
  cotizacionesCreadaPor   Cotizacion[]               @relation("CotizacionesCreadaPor")
  actividadesDeals        DealActivity[]             @relation("DealActivities")
  archivosDeals           DealAttachment[]           @relation("DealAttachments")
  dealsAsignados          Deal[]                     @relation("DealsAsignados")
  digitalCard             DigitalCard?               @relation("UserDigitalCard")
  employee                Employee?
  expensesCreated         Expense[]                  @relation("ExpenseCreator")
  erp_sales_order_audits  erp_sales_order_audits[]
  stockMovements          StockMovement[]            @relation("StockMovementUser")
  googleCalendar          GoogleCalendarIntegration? @relation("UserGoogleCalendar")
  inAppNotifications      InAppNotification[]
  incomingWebhooks        IncomingWebhook[]
  leadAttachments         LeadAttachment[]           @relation("LeadAttachments")
  metasVenta              MetaVenta[]                @relation("MetasVenta")
  ordenesVentaCreadoPor   OrdenVenta[]               @relation("OrdenVentaCreadoPor")
  outgoingWebhooks        OutgoingWebhook[]
  componentesCreados      PageComponent[]            @relation("ComponentCreator")
  paginasCreadas          Page[]                     @relation("PageCreator")
  plaudernAutoAssignments PlaudernIntegration[]      @relation("PlaudernAutoAssignUser")
  salesPlaybookEntries    SalesPlaybookEntry[]
  trainingSessions        TrainingSession[]
  marketingAuditLogs      MarketingAuditLog[]
  chatMessages            ChatMessage[]
  chatSubscriptions       ChatSubscription[]
  createdTickets          SupportTicket[]            @relation("TicketCreator")
  assignedTickets         SupportTicket[]            @relation("TicketAssignee")

  @@index([tenantId])
  @@index([roleId])
  @@index([email])
  @@index([estado])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserWhatsAppInstance {
  id            String    @id @default(cuid())
  userId        String
  tenantId      String
  instanceName  String    @unique
  phoneNumber   String?
  status        String    @default("disconnected")
  qrCode        String?
  qrCodeExpiry  DateTime?
  profileName   String?
  profilePicUrl String?
  totalMensajes Int       @default(0)
  ultimoMensaje DateTime?
  fechaConexion DateTime?
  fechaCreacion DateTime  @default(now())
  fechaEdicion  DateTime  @updatedAt
  tenant        Tenant    @relation("TenantWhatsAppInstances", fields: [tenantId], references: [id], onDelete: Cascade)
  user          User      @relation("UserWhatsAppInstances", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([instanceName])
  @@index([status])
}

model Tenant {
  id                             String                           @id @default(cuid())
  nombre                         String
  slug                           String                           @unique
  plan                           String                           @default("basico")
  estado                         String                           @default("activo")
  configuracion                  Json?
  limites                        Json?
  fechaCreacion                  DateTime                         @default(now())
  fechaActualizacion             DateTime                         @updatedAt
  fechaVencimiento               DateTime?
  billingEmail                   String?
  dominio                        String?
  fechaTrialFin                  DateTime?
  fechaTrialInicio               DateTime?
  moneda                         String                           @default("MXN")
  mrr                            Float                            @default(0)
  stripeCustomerId               String?
  nexusEnabled                   Boolean                          @default(true)
  dbUrl                          String?
  accountType                    AccountType                      @default(BUSINESS)
  baseLatitude                   Float?
  baseLongitude                  Float?
  brandingConfig                 Json?
  dnaOperativo                   String?                          @default("CRM_CORE")
  enabledModules                 String[]                         @default(["CRM"])
  genesisHash                    String?
  masterKeyHash                  String?
  maxSlots                       Int                              @default(0)
  parentId                       String?
  provisioningStatus             String                           @default("PENDING")
  vaultSeed                      String?                          @unique
  direccionFiscal                String?
  nifCif                         String?
  razonSocial                    String?
  aiAutopilot                    Boolean                          @default(false)
  AcademyPath                    AcademyPath[]
  AiDecisionLog                  AiDecisionLog[]
  attendanceRules                AttendanceRules?
  auditLogs                      AuditLog[]
  automations                    Automation[]
  bundles                        Bundle[]
  campaigns                      Campaign[]
  automationRules                AutomationRule[]
  automationLogs                 AutomationLog[]
  automationRuleVersions         AutomationRuleVersion[]
  marketingAuditLogs             MarketingAuditLog[]
  marketingSuppressions          MarketingSuppression[]
  Certificado                    Certificado[]
  chatbotConfig                  ChatbotConfig?
  citas                          Cita[]
  configuraciones                Configuracion[]
  conversations                  Conversation[]
  cupones                        Cupon[]
  cursos                         Curso[]
  EmployeeBenefit                EmployeeBenefit[]
  estudiantes                    Estudiante[]
  leads                          Lead[]
  MessageDraft                   MessageDraft[]
  quizzes                        Quiz[]
  roles                          Role[]
  servicios                      Servicio[]
  socialConfigs                  SocialPlatformConfig[]
  socialPosts                    SocialPost[]
  tareas                         Tarea[]
  tasks                          Task[]
  Tenant                         Tenant?                          @relation("TenantToTenant", fields: [parentId], references: [id])
  other_Tenant                   Tenant[]                         @relation("TenantToTenant")
  users                          User[]
  whatsappInstances              UserWhatsAppInstance[]           @relation("TenantWhatsAppInstances")
  abTestResults                  ABTestResult[]
  agent_skill_logs               agent_skill_logs[]
  anytimebotIntegration          AnytimebotIntegration?
  apiKeys                        ApiKey[]
  audiences                      Audience[]
  businessDomains                BusinessDomain[]
  campaignRecipients             CampaignRecipient[]
  catalogoFieldDefinitions       CatalogoFieldDefinition[]        @relation("TenantCatalogoFieldDefinitions")
  catalogoItems                  CatalogoItem[]
  channels                       Channel[]
  signatureSettings              ClientSignatureSettings?
  client_subscriptions           client_subscriptions[]
  comisiones                     Comision[]
  configuracionesFiscales        ConfiguracionFiscalEmisor[]
  contacts                       Contact[]
  contratoPagos                  ContratoPago[]
  contratos                      Contrato[]
  cotizaciones                   Cotizacion[]
  dealActivities                 DealActivity[]
  dealAttachments                DealAttachment[]
  deals                          Deal[]
  digitalCards                   DigitalCard[]                    @relation("TenantDigitalCards")
  emailCampaigns                 EmailCampaign[]
  emailTemplates                 EmailTemplate[]
  erp_academy_audit_logs         erp_academy_audit_logs[]
  erp_academy_users              erp_academy_users[]
  billOfMaterials                BillOfMaterials[]
  erp_capacity_forecasts         erp_capacity_forecasts[]
  erp_capacity_snapshots         erp_capacity_snapshots[]
  erp_cost_components            erp_cost_components[]
  erp_customer_claims            erp_customer_claims[]
  erp_customer_org_members       erp_customer_org_members[]
  erp_customer_portal_access     erp_customer_portal_access[]
  erp_customer_private_documents erp_customer_private_documents[]
  erp_customer_users             erp_customer_users[]
  erp_delivery_confirmations     erp_delivery_confirmations[]
  erp_delivery_promises          erp_delivery_promises[]
  erp_digital_access             erp_digital_access[]
  erp_digital_signatures         erp_digital_signatures[]
  erp_employee_assets            erp_employee_assets[]
  erp_employee_schedules         erp_employee_schedules[]
  employees                      Employee[]
  erp_expense_claims             erp_expense_claims[]
  expenses                       Expense[]
  financialAudits                FinancialAudit[]
  financialSummaries             FinancialSummary[]
  accountingAccounts             AccountingAccount[]
  accountingEntries              AccountingEntry[]
  bankConnections                BankConnection[]
  taxRecords                     TaxRecord[]
  accountingPeriods              AccountingPeriod[]
  erp_industrial_assets          erp_industrial_assets[]
  erp_inventory_lots             erp_inventory_lots[]
  erp_maintenance_logs           erp_maintenance_logs[]
  erp_maintenance_orders         erp_maintenance_orders[]
  erp_material_requirements      erp_material_requirements[]
  erp_material_shortages         erp_material_shortages[]
  erp_order_reservations         erp_order_reservations[]
  payrollRecords                 PayrollRecord[]
  erp_portal_verification_logs   erp_portal_verification_logs[]
  erp_procurement_suggestions    erp_procurement_suggestions[]
  erp_product_families           erp_product_families[]
  erp_production_capacity        erp_production_capacity[]
  erp_production_costing         erp_production_costing[]
  erp_production_lines           erp_production_lines[]
  productionLogs                 ProductionLog[]
  erp_production_readiness       erp_production_readiness[]
  projectMilestones              ProjectMilestone[]
  projects                       Project[]
  qualityChecks                  QualityCheck[]
  nonConformities                NonConformity[]
  qualityPoints                  QualityPoint[]
  erp_sales_order_audits         erp_sales_order_audits[]
  erp_sales_order_items          erp_sales_order_items[]
  erp_sales_orders               erp_sales_orders[]
  erp_schedule_assignments       erp_schedule_assignments[]
  erp_schedule_constraints       erp_schedule_constraints[]
  erp_schedule_decision_logs     erp_schedule_decision_logs[]
  erp_scheduling_plans           erp_scheduling_plans[]
  securityIncidents              SecurityIncident[]
  erp_shift_plans                erp_shift_plans[]
  erp_shipments                  erp_shipments[]
  stockLevels                    StockLevel[]
  stockMovements                 StockMovement[]
  suppliers                      Supplier[]
  erp_vacation_requests          erp_vacation_requests[]
  warehouses                     Warehouse[]
  workOrders                     WorkOrder[]
  externalLeadSearches           ExternalLeadSearch[]
  googleCalendarIntegrations     GoogleCalendarIntegration[]      @relation("TenantGoogleCalendars")
  inAppNotifications             InAppNotification[]
  incomingWebhookDeliveries      IncomingWebhookDelivery[]
  incomingWebhooks               IncomingWebhook[]
  integrations                   Integration[]
  invoices                       Invoice[]
  leadAttachments                LeadAttachment[]                 @relation("TenantLeadAttachments")
  leadFieldDefinitions           LeadFieldDefinition[]            @relation("TenantLeadFieldDefinitions")
  messagingHubConfig             MessagingHubConfig?
  metasVenta                     MetaVenta[]
  n8nWorkflows                   N8nWorkflow[]                    @relation("TenantN8nWorkflows")
  notificationLogs               NotificationLog[]
  notifications                  Notification[]
  ordenesVenta                   OrdenVenta[]
  outgoingWebhookDeliveries      OutgoingWebhookDelivery[]
  outgoingWebhooks               OutgoingWebhook[]
  pages                          Page[]
  perfilesFiscalesClientes       PerfilFiscalCliente[]
  pipelineStages                 PipelineStage[]
  plaudernIntegration            PlaudernIntegration?             @relation("TenantPlaudernIntegration")
  salesPlaybookEntries           SalesPlaybookEntry[]
  savedSearches                  SavedSearch[]
  scannedCards                   ScannedCard[]                    @relation("TenantScannedCards")
  signatureRequests              SignatureRequest[]
  subscriptions                  Subscription[]
  tasasImpuesto                  TasaImpuesto[]
  tenantFeatures                 TenantFeature[]
  tenantWorkflows                TenantWorkflow[]                 @relation("TenantWorkflows")
  trainingSessions               TrainingSession[]
  unsubscribeList                UnsubscribeList[]
  contentAssets                  ContentAsset[]
  webForms                       WebForm[]
  webFormSubmissions             WebFormSubmission[]
  chatChannels                   ChatChannel[]
  chatMessages                   ChatMessage[]
  chatSubscriptions              ChatSubscription[]
  gemmaRequests                  GemmaRequest[]
  gemmaResponses                 GemmaResponse[]
  ChatAttribution                ChatAttribution[]
  supportTickets                 SupportTicket[]
  strategySnapshots              StrategySnapshot[]
  profitabilityRecords           ProfitabilityRecord[]
  cashflowProjections            CashflowProjection[]
  strategicRecommendations       StrategicRecommendation[]
  executiveAlerts                ExecutiveAlert[]
  assets                         Asset[]
  assetAssignments               AssetAssignment[]
  assetMaintenance               AssetMaintenance[]
  assetEvents                    AssetEvent[]
  discoverySignals               DiscoverySignal[]
  marketObservations             MarketObservation[]
  externalLeads                  ExternalLead[]
  competitiveInsights            CompetitiveInsight[]
  knowledgeArticles              KnowledgeArticle[]
  userGuidanceLogs               UserGuidanceLog[]
}

model AttendanceRules {
  id                 String  @id @default(cuid())
  tenantId           String  @unique
  requireSelfie      Boolean @default(true)
  requireGPS         Boolean @default(true)
  randomPulsesPerDay Int     @default(2)
  gracePeriodMinutes Int     @default(3)
  antiSpoofingLevel  String  @default("HIGH")
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model GlobalAuditCloud {
  id        String   @id @default(cuid())
  tenantId  String
  action    String
  hash      String?
  details   String?
  timestamp DateTime @default(now())
  ip        String?

  @@index([tenantId])
  @@index([action])
}

model OnboardingProgress {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  configuracionBasica   Boolean   @default(false)
  primerLead            Boolean   @default(false)
  primerServicio        Boolean   @default(false)
  configuracionCanales  Boolean   @default(false)
  primeraAutomatizacion Boolean   @default(false)
  invitacionEquipo      Boolean   @default(false)
  completado            Boolean   @default(false)
  omitido               Boolean   @default(false)
  pasoActual            Int       @default(0)
  fechaInicio           DateTime  @default(now())
  fechaCompletado       DateTime?
  ultimaActualizacion   DateTime  @updatedAt
  primeraPagina         Boolean   @default(false)
  dnaOperativo          String?   @default("CRM_CORE")
  gpsConfigurado        Boolean   @default(false)
  masterKeyConfigurado  Boolean   @default(false)
  watchdogConectado     Boolean   @default(false)

  @@index([tenantId])
}

model Role {
  id                 String   @id @default(cuid())
  tenantId           String?
  nombre             String
  descripcion        String?
  permisos           Json
  esPersonalizado    Boolean  @default(false)
  orden              Int      @default(0)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
  tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users              User[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model AuditLog {
  id             String   @id @default(cuid())
  tenantId       String?
  userId         String?
  accion         String
  entidad        String
  entidadId      String
  descripcion    String
  cambiosAntes   Json?
  cambiosDespues Json?
  ipAddress      String?
  userAgent      String?
  metadata       Json?    @default("{}")
  hash           String?
  fechaCreacion  DateTime @default(now())
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([entidad])
  @@index([entidadId])
  @@index([fechaCreacion])
}

model Lead {
  id                   String               @id @default(cuid())
  nombre               String
  email                String
  telefono             String?
  notas                String?
  estado               String               @default("nuevo")
  fechaCreacion        DateTime             @default(now())
  fechaActualizacion   DateTime             @updatedAt
  asignadoA            String?
  tiempoEnEstado       DateTime             @default(now())
  tenantId             String?
  cargo                String?
  empresa              String?
  fuente               String?
  linkedin             String?
  metadataExterna      Json?
  ubicacion            String?
  fechaUltimaActividad DateTime             @default(now())
  scoreValue           Int                  @default(0)
  aiStrategy           String?
  riskLevel            Int                  @default(0)
  tags                 String?
  convertedAt          DateTime?
  convertedToContactId String?
  status               String               @default("new")
  contextoProyecto     String?
  fechaPrimeraVista    DateTime?
  tokenPublico         String?              @unique
  ultimaVista          DateTime?
  vecesVista           Int                  @default(0)
  chatwootAccountId    Int?
  externalContactRef   String?
  citas                Cita[]
  conversaciones       Conversation[]
  interacciones        Interaction[]
  asignadoUsuario      User?                @relation("LeadAssignee", fields: [asignadoA], references: [id])
  convertedToContact   Contact?             @relation("LeadConversion", fields: [convertedToContactId], references: [id])
  tenant               Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  score                LeadScore?
  MessageDraft         MessageDraft[]
  notasTimestamp       Note[]
  scoreHistory         ScoreHistory[]
  tareas               Task[]
  campaignLeads        CampaignLead[]
  campaignRecipients   CampaignRecipient[]
  contratos            Contrato[]
  cotizaciones         Cotizacion[]
  deals                Deal[]
  expenses             Expense[]
  projects             Project[]
  invoices             Invoice[]
  attachments          LeadAttachment[]
  ordenesVenta         OrdenVenta[]         @relation("LeadOrdenesVenta")
  perfilFiscal         PerfilFiscalCliente? @relation("LeadPerfilFiscal")
  scannedCards         ScannedCard[]        @relation("LeadFromScannedCard")
  signatureRequests    SignatureRequest[]
  TrainingSession      TrainingSession[]
  unsubscribes         UnsubscribeList[]

  @@index([tenantId])
  @@index([email])
  @@index([estado])
  @@index([status])
  @@index([asignadoA])
  @@index([fuente])
  @@index([convertedToContactId])
}

model LeadFieldDefinition {
  id           String   @id @default(cuid())
  tenantId     String
  fieldKey     String
  label        String
  type         String
  options      Json?
  required     Boolean  @default(false)
  orden        Int      @default(0)
  placeholder  String?
  valorDefecto String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation("TenantLeadFieldDefinitions", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fieldKey])
  @@map("lead_field_definitions")
}

model LeadAttachment {
  id                 String   @id @default(cuid())
  leadId             String?
  tenantId           String
  userId             String?
  nombre             String
  tipoArchivo        String
  tamano             Int
  cloud_storage_path String
  descripcion        String?
  fechaSubida        DateTime @default(now())
  contactId          String?
  contacts           Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead               Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant             Tenant   @relation("TenantLeadAttachments", fields: [tenantId], references: [id], onDelete: Cascade)
  usuario            User?    @relation("LeadAttachments", fields: [userId], references: [id])

  @@index([leadId])
  @@index([tenantId])
  @@index([contactId])
  @@map("lead_attachments")
}

model Contact {
  id                             String                           @id @default(cuid())
  tenantId                       String
  nombre                         String
  email                          String
  telefono                       String?
  tipo                           String                           @default("person")
  companyId                      String?
  cargo                          String?
  ubicacion                      String?
  linkedin                       String?
  notas                          String?
  tags                           String?
  fechaCreacion                  DateTime                         @default(now())
  fechaActualizacion             DateTime                         @updatedAt
  isTaxValidated                 Boolean                          @default(false)
  Cita                           Cita[]
  Conversation                   Conversation[]
  Interaction                    Interaction[]
  convertedFromLeads             Lead[]                           @relation("LeadConversion")
  Note                           Note[]
  Task                           Task[]
  client_subscriptions           client_subscriptions[]
  company                        Contact?                         @relation("CompanyPersons", fields: [companyId], references: [id])
  persons                        Contact[]                        @relation("CompanyPersons")
  tenant                         Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos                      Contrato[]
  cotizaciones                   Cotizacion[]
  dealsAsCompany                 Deal[]                           @relation("CompanyDeals")
  deals                          Deal[]                           @relation("ContactDeals")
  erp_customer_claims            erp_customer_claims[]
  erp_customer_private_documents erp_customer_private_documents[]
  erp_customer_users             erp_customer_users[]
  erp_sales_orders               erp_sales_orders[]
  invoices                       Invoice[]
  lead_attachments               LeadAttachment[]
  ordenesVenta                   OrdenVenta[]                     @relation("ContactOrdenesVenta")
  perfilFiscal                   PerfilFiscalCliente?             @relation("ContactPerfilFiscal")

  @@index([tenantId])
  @@index([email])
  @@index([tipo])
  @@index([companyId])
  @@map("contacts")
}

model Servicio {
  id                 String        @id @default(cuid())
  nombre             String
  descripcion        String?
  duracionMinutos    Int
  precio             Float
  moneda             String        @default("EUR")
  activo             Boolean       @default(true)
  fechaCreacion      DateTime      @default(now())
  fechaActualizacion DateTime      @updatedAt
  tenantId           String?
  modalidad          String        @default("presencial")
  catalogoItemId     String?
  citas              Cita[]
  catalogoItem       CatalogoItem? @relation(fields: [catalogoItemId], references: [id])
  tenant             Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([catalogoItemId])
}

model Cita {
  id                       String        @id @default(cuid())
  leadId                   String
  servicioId               String?
  fechaHora                DateTime
  estado                   String        @default("pendiente")
  montoPagado              Float?
  stripePaymentId          String?
  fechaCreacion            DateTime      @default(now())
  fechaActualizacion       DateTime      @updatedAt
  tenantId                 String?
  descripcion              String?
  duracion                 Int           @default(60)
  titulo                   String?
  linkReunion              String?
  tipo                     String        @default("reunion")
  ubicacion                String?
  googleCalendarEventId    String?
  emailConfirmacionEnviado Boolean       @default(false)
  fechaEmailConfirmacion   DateTime?
  hashDatosEmail           String?
  recordatorio24hEnviado   Boolean       @default(false)
  recordatorio1hEnviado    Boolean       @default(false)
  origenCita               String        @default("volkern")
  catalogoItemId           String?
  usuarioAsignadoId        String?
  contactId                String?
  catalogoItem             CatalogoItem? @relation(fields: [catalogoItemId], references: [id])
  contacts                 Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead                     Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  servicio                 Servicio?     @relation(fields: [servicioId], references: [id])
  tenant                   Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioAsignado          User?         @relation("CitaAssignee", fields: [usuarioAsignadoId], references: [id])

  @@index([tenantId])
  @@index([usuarioAsignadoId])
  @@index([fechaHora])
