  descripcionLarga          String?
  diasExpiracion            Int?
  faq                       Json?
  fechaInicio               DateTime?
  imagenDestacada           String?
  instructorBio             String?
  instructorFirma           String?
  instructorImagen          String?
  instructorNombre          String?
  metaDescripcion           String?
  nivelMembresia            String?
  permiteCalificaciones     Boolean       @default(true)
  permiteComentarios        Boolean       @default(true)
  permiteCupones            Boolean       @default(true)
  precioSuscripcion         Float?
  puntuajeMinimoCertificado Int           @default(80)
  subtitulo                 String?
