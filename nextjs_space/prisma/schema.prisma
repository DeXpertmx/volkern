  projectId       String?
  status          String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  quantityToMake  Int
  quantityProduced Int     @default(0)
  wasteReported   Int      @default(0)
  wasteImage      String?  // URL de la evidencia para Gemma Vision
  batchNumber     String?  @unique
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bom             BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  project         Project? @relation(fields: [projectId], references: [id])
  productionLogs  ProductionLog[]
  qualityChecks   QualityCheck[]
  nonConformities NonConformity[]

  @@index([tenantId])
  @@index([bomId])
  @@index([projectId])
  @@map("erp_work_orders")
}

model ProductionLog {
  id            String   @id @default(cuid())
  tenantId      String
  workOrderId   String?  // Opcional para consumos automáticos sin WO
  action        String   // CONSUMPTION, OUTPUT, SCRAP, AUTOMATIC_CONSUMPTION
  itemId        String?  // Referencia manual al CatalogoItem involucrado
  catalogoItemId String?  // Relación formal con CatalogoItem
  quantity      Float    @default(0)
  userId        String?
  timestamp     DateTime @default(now())
  reportLat     Float?
  reportLng     Float?
  clientTimestamp DateTime?
  
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  catalogoItem  CatalogoItem? @relation(fields: [catalogoItemId], references: [id])

  @@index([tenantId])
  @@index([workOrderId])
  @@index([catalogoItemId])
  @@map("erp_production_logs")
}

// ============================================
// FASE 6: CALIDAD (QC)
// ============================================

model QualityPoint {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  targetValue     String?  // Valor esperado
  tolerance       String?  // Tolerancia admitida
  mandatory       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  qualityChecks   QualityCheck[]

  @@index([tenantId])
  @@map("erp_qc_points")
}

model QualityCheck {
  id              String   @id @default(cuid())
  tenantId        String
  projectId       String?
  workOrderId     String?
  pointId         String
  status          String   @default("PASSED") // PASSED, FAILED, WARNING
  measuredValue   String?
  notes           String?
  inspectorId     String?
  evidenceUrl     String?  // Foto del resultado
  integrityHash   String?  // SHA-256 del reporte para validez legal
  createdAt       DateTime @default(now())
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project? @relation(fields: [projectId], references: [id])
  workOrder       WorkOrder? @relation(fields: [workOrderId], references: [id])
  point           QualityPoint @relation(fields: [pointId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([workOrderId])
  @@map("erp_qc_checks")
}

model NonConformity {
  id              String   @id @default(cuid())
  tenantId        String
  projectId       String?
  workOrderId     String?
  description     String
  severity        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status          String   @default("OPEN") // OPEN, UNDER_REVIEW, CLOSED, REJECTED
  rootCause       String?
  correctiveAction String?
  reportedBy      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project? @relation(fields: [projectId], references: [id])
  workOrder       WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([workOrderId])
  @@map("erp_qc_non_conformities")
}

// ============================================
// FASE 7: RRHH (HRM & NÓMINA)
// ============================================

model Employee {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String?  @unique // Vinculación opcional con cuenta de usuario
  fullName        String
  email           String?
  role            String   @default("OPERATOR")
  department      String   @default("GENERAL")
  hiringDate      DateTime @default(now())
  
  // 🛡️ THE VAULT 2.0: Datos cifrados AES-256-GCM
  salaryEncrypted     String?
  contractUrlEncrypted String?
  encryptionKeyId     String?  // ID de la clave usada para rotación
  
  // 📍 GEOFENCING & TELETRABAJO
  isTeleworkAllowed   Boolean  @default(false)
  allowedTeleworkLat  Float?
  allowedTeleworkLng  Float?
  teleworkRadius      Int      @default(100) // Metros de tolerancia
  
  // 📸 IDENTITY & PATTERN
  faceVector          String?  // Vector de identidad para validación facial
  baseGPSLat          Float?   // Punto de referencia GPS (Planta/Oficina)
  baseGPSLng          Float?
  homeOfficeLat       Float?   // Base para teletrabajo
  homeOfficeLng       Float?

  // 🛡️ ÉTICA IA: Grupo demográfico anonimizado para auditoría de equidad
  // Nunca obligatorio. Ej: "ES", "FR", "DE" o "A", "B", "C" (totalmente anonimizado)
  demographicGroup    String?

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id])
  payrollRecords  PayrollRecord[]
  attendances     Attendance[]

  @@index([tenantId])
  @@index([userId])
  @@map("erp_employees")
}

model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  tenantId      String
  type          String   // "IN", "OUT"
  timestamp     DateTime @default(now())
  method        String   // "WEB", "APP", "QR", "FACE"
  locationLat   Float?
  locationLng   Float?
  
  // 🛡️ INTEGRITY HASH (Evita manipulación manual de horas en DB)
  integrityHash String
  
  // Metadatos de Verificación
  evidenceUrl   String?  // Selfie de validación
  isAnomaly     Boolean  @default(false)
  anomalyType   String?  // "GPS_MISMATCH", "TIME_DRIFT", "FACE_REJECTED"

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  challenges    AttendanceChallenge[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([timestamp])
  @@map("erp_attendance_logs")
}

model AttendanceChallenge {
  id            String   @id @default(cuid())
  attendanceId  String
  type          String   // "RANDOM_SELFIE", "QR_SYNC"
  status        String   @default("PENDING") // PENDING, PASSED, FAILED, TIMEOUT
  evidenceUrl   String?
  timestamp     DateTime @default(now())
  deadline      DateTime // Límite para responder (ej. +3 min)

  attendance    Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@map("erp_attendance_challenges")
}

model PayrollRecord {
  id              String   @id @default(cuid())
  tenantId        String
  employeeId      String
  month           Int
  year            Int
  status          String   @default("PENDING") // PENDING, PAID, CANCELLED
  paymentDate     DateTime?
  
  // 🛡️ THE VAULT 2.0: Monto cifrado 
  amountEncrypted String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@map("erp_payroll_records")
}

// ============================================
// MÓDULO DE AUDITORÍA Y CUMPLIMIENTO ÉTICO
// AI Act EU · RGPD · Equidad Algorítmica
// ============================================

/// Registro inmutable de auditorías de equidad (Blockchain-like)
/// Cada entrada encadena su hash con el registro anterior
model AuditVault {
  id             String    @id @default(cuid())
  auditDate      DateTime  @default(now())
  biasScore      Float     // Coeficiente de Variación (CV) — 0 = perfecta equidad
  status         String    // VERDE, AMARILLO, ROJO
  integrityHash  String    // SHA-256(biasScore + status + timestamp + prevHash)
  prevHash       String?   // Hash del registro anterior (cadena blockchain)
  findingSummary String
  actionTaken    String    @default("NINGUNA") // NINGUNA, ALERTA_ENVIADA, BLOQUEO_PREVENTIVO
  totalRecords   Int       @default(0)
  groupBreakdown Json?     // { "ES": 120, "FR": 45, "DE": 38 } distribución por grupo
  // Override manual: si un admin revisa y determina falso positivo
  resolvedBy     String?   // Email del admin que autorizó la reactivación
  resolvedAt     DateTime?
  resolutionNote String?   // Justificación escrita obligatoria (queda en audit trail)

  @@index([auditDate])
  @@index([status])
  @@map("audit_vault")
}

/// Alertas del sistema para el Backoffice (AMARILLO/ROJO generados por el auditor)
model SystemAlert {
  id         String    @id @default(cuid())
  level      String    // INFO, WARNING, CRITICAL
  message    String
  auditId    String?   // Referencia al AuditVault que generó la alerta
  resolved   Boolean   @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolved])
  @@index([level])
  @@index([createdAt])
  @@map("system_alerts")
}

/// Kill Switch tipado para módulos de IA
/// Reemplaza la tabla system_config de texto plano con un modelo Prisma auditado
model AiModuleControl {
  id        String   @id @default(cuid())
  moduleKey String   @unique // "random_presence_tests", "face_recognition", etc.
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?  // Email del actor (sistema automático o admin humano)
  reason    String?  // Motivo de la activación/desactivación

  @@index([moduleKey])
  @@map("ai_module_controls")
}
