  // Huella de la lección cosechada (tema + objeción normalizada, sha256):
  // dos sesiones muy parecidas NO crean dos entradas casi iguales — la sonda
  // de cosecha encuentra la huella y devuelve la entrada existente. Null en
  // entradas manuales (los NULL no colisionan en un unique de Postgres).
  objection       String
  bestResponse    String
  technique       String?
  sourceSessionId String?
