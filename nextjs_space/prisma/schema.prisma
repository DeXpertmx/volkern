  @@index([tenantId])
}

model Pregunta {
  id            String                @id @default(cuid())
  quizId        String
  pregunta      String
  tipoPregunta  String                @default("multiple_choice")
  orden         Int
  puntaje       Int                   @default(1)
  opciones      Json?
  explicacion   String?
  fechaCreacion DateTime              @default(now())
  quiz          Quiz                  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  respuestas    RespuestaEstudiante[]

  @@index([quizId])
  @@index([orden])
}

model IntentoQuiz {
  id                  String                @id @default(cuid())
  estudianteId        String
  quizId              String
  numeroIntento       Int                   @default(1)
