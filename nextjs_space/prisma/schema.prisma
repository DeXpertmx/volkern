  historialTransacciones   Json?
  fechaRenovacion          DateTime?
  cuponesAplicados         Json?
  ultimoAcceso             DateTime?
  dispositivosUsados       Json?
  interaccionesChatbot     Json?
  preferenciasNotificacion Json?
  tags                     String[]          @default([])
  consentimientoGDPR       Boolean           @default(false)
  fechaConsentimiento      DateTime?
  fechaAceptacionTerminos  DateTime?
