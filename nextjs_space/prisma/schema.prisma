model AssetAssignment {
  id              String   @id @default(cuid())
  assetId         String
  employeeId      String
  tenantId        String
  assignedAt      DateTime @default(now())
  returnedAt      DateTime?
  conditionOn     String?  // 'NEW', 'GOOD', 'DAMAGED'
  conditionOff    String?
  note            String?  @db.Text

  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([employeeId])
  @@map("erp_asset_assignments")
}

model AssetMaintenance {
  id              String   @id @default(cuid())
  assetId         String
  tenantId        String
  date            DateTime @default(now())
  type            String   // 'PREVENTIVE', 'CORRECTIVE', 'UPGRADE'
  description     String   @db.Text
  cost            Float?
  provider        String?
  ticketId        String?  // Linked to SupportTicket if any

  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("erp_asset_maintenance")
}

model AssetEvent {
  id              String   @id @default(cuid())
  assetId         String
  tenantId        String
  eventType       String   // 'CREATION', 'ASSIGNMENT', 'RETURN', 'MAINTENANCE', 'LOSS', 'RETIREMENT'
  description     String   @db.Text
  actorId         String?  // User ID
  metadata        Json?
  hash            String?  // For Trust Protocol sealing
  createdAt       DateTime @default(now())

  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("erp_asset_events")
}

model DiscoverySignal {
  id              String   @id @default(cuid())
  tenantId        String
  source          String   // 'GOOGLE_SEARCH', 'NEWS_FEED', 'LINKEDIN', 'CUSTOM_MCP'
  entityType      String   // 'COMPETITOR', 'MARKET_TREND', 'POTENTIAL_LEAD'
  headline        String   @db.Text
  summary         String   @db.Text
  url             String?
  score           Float    @default(0)
  confidence      Float    @default(0)
  status          String   @default("NEW") // 'NEW', 'ANALYZED', 'CONVERTED', 'REJECTED'
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([source])
  @@map("erp_discovery_signals")
}

model ExternalLead {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  company         String?
  sourceUrl       String?
  industry        String?
  signals         Json?    @default("[]") // IDs of signals that triggered this lead
  aiScore         Float
  aiReasoning     String?  @db.Text
  convertedLeadId String?  // ID of the CRM Lead if converted
  status          String   @default("DISCOVERED") // 'DISCOVERED', 'QUALIFIED', 'CONVERTED', 'ARCHIVED'
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@map("erp_external_leads")
}

model CompetitiveInsight {
  id              String   @id @default(cuid())
  tenantId        String
  competitorName  String
  type            String   // 'PRICING_CHANGE', 'NEW_PRODUCT', 'MARKET_EXPANSION'
  insight         String   @db.Text
  evidenceUrl     String?
  impactLevel     String   @default("MEDIUM") // 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'
  metadata        Json?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@map("erp_competitive_insights")
