// ─── OportunidadComercial ─────────────────────────────────────────────────────

model OportunidadComercial {
  id                String                @id @default(cuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones
  clienteId         String
  cliente           Contact               @relation("OportunidadCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  polizaOrigenId    String?
  polizaOrigen      Poliza?               @relation("OportunidadPolizaOrigen", fields: [polizaOrigenId], references: [id], onDelete: SetNull)
  productoSugeridoId String
  productoSugerido  ProductoSeguro        @relation(fields: [productoSugeridoId], references: [id], onDelete: Cascade)

  // Datos de la oportunidad
  titulo            String
  origen            OrigenOportunidad     @default(IA)
  probabilidad      Int
  primaEstimada     Decimal?
  estado            EstadoOportunidad     @default(NUEVA)

  // Seguimiento
  agenteAsignadoId  String?
  agenteAsignado    User?                 @relation("OportunidadAgente", fields: [agenteAsignadoId], references: [id])
  fechaCierre       DateTime?
