  inscripciones             Inscripcion[]
  modulos                   Modulo[]
  reviews                   Review[]

  @@index([tenantId])
  @@index([publicado])
  @@index([categoria])
  @@index([urlSlug])
  @@index([catalogoItemId])
}

model Modulo {
  id                 String    @id @default(cuid())
