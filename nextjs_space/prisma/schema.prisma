  fechaLanzamiento   DateTime?
  moduloPrevioId     String?
  tipoDrip           String    @default("none")
  lecciones          Leccion[]
  curso              Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@index([cursoId])
  @@index([orden])
}

model Leccion {
  id                 String            @id @default(cuid())
  moduloId           String
  titulo             String
  descripcion        String?
  contenido          String?
  videoUrl           String?
  duracionMinutos    Int?
  materialesUrl      Json?
  orden              Int
  tipoContenido      String            @default("video")
  fechaCreacion      DateTime          @default(now())
  fechaActualizacion DateTime          @updatedAt
  diasDespues        Int?
  fechaLanzamiento   DateTime?
  leccionPreviaId    String?
  pdfUrl             String?
  permitirDescarga   Boolean           @default(true)
  quizId             String?
  tareaId            String?
  tipoDrip           String            @default("none")
  transcripcion      String?
  videoTipo          String?
  comentarios        Comentario[]
