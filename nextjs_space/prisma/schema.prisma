  integrityHash   String?
  signature       String?
  fechaExpiracion DateTime?
  metadata        Json?
  tenantId        String?
  curso           Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  estudiante      Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  Tenant          Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, cursoId])
  @@index([estudianteId])
  @@index([cursoId])
  @@index([codigoUnico])
}

model Quiz {
  id                  String        @id @default(cuid())
  tenantId            String?
  titulo              String
  descripcion         String?
  tipoQuiz            String        @default("quiz")
  puntuajeMinimo      Int           @default(70)
  intentosPermitidos  Int           @default(-1)
  tiempoLimiteMinutos Int?
