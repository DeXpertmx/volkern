model Captacion {
  id                    String  @id @default(cuid())
  tenantId              String
  propiedadId           String?
  contactoPropietarioId String?
  creadoPor             String?

  // Tipo de captación: exclusiva, compartida, mandato
  tipoCaptacion String @default("exclusiva")
  // Estado: borrador, activa, vencida, cancelada, cerrada
  estado        String @default("borrador")

  // Fechas del contrato
  fechaInicio      DateTime
  fechaFin         DateTime
  fechaFirma       DateTime?
  fechaVencimiento DateTime?
  fechaCancelacion DateTime?

  // Exclusividad
  esExclusiva           Boolean @default(true)
  clausulasExclusividad String?

  // Precio ofertado
  precioOferta Float?
  precioMinimo Float?

  // Comisión de captación
  comisionPorcentaje  Float?
  comisionFija        Float?
  comisionMoneda      String  @default("EUR")
  comisionCondiciones String?
  comisionNotas       String?

  // Condiciones de pago
  condicionesPago String?

  // Documentos
  documentoUrl  String?
  documentoHash String?

  // Notas
  notasCliente  String?
  notasInternas String?

  // Auditoría e integridad
  auditHash      String?   @unique
  chainedHash    String?
  sealedAt       DateTime?
  signatureAudit Json?
  metadata       Json?

  // Timestamps
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  // Relaciones
  propiedad           CatalogoItem? @relation("CaptacionPropiedad", fields: [propiedadId], references: [id])
  contactoPropietario Contact?      @relation("CaptacionPropietario", fields: [contactoPropietarioId], references: [id])
  creador             User?         @relation("CaptacionesCreadas", fields: [creadoPor], references: [id])
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propiedadId])
  @@index([contactoPropietarioId])
  @@index([estado])
  @@index([fechaInicio])
  @@index([fechaFin])
  @@map("captaciones")
}

