  estudiante           Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, cursoId])
  @@index([estudianteId])
  @@index([cursoId])
  @@index([estado])
}

model ProgresoLeccion {
  id              String     @id @default(cuid())
  estudianteId    String
  leccionId       String
  completado      Boolean    @default(false)
  tiempoVisto     Int        @default(0)
  fechaInicio     DateTime   @default(now())
  fechaCompletado DateTime?
  estudiante      Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  leccion         Leccion    @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, leccionId])
  @@index([estudianteId])
  @@index([leccionId])
}

model Certificado {
  id              String     @id @default(cuid())
  estudianteId    String
  cursoId         String
  codigoUnico     String     @unique
  fechaEmision    DateTime   @default(now())
