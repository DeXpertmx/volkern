  badgeId                String?                   @unique
  bankAccount            String?
  birthCountry           String?
  birthDate              DateTime?
  birthPlace             String?
  carPlate               String?
  childrenCount          Int                       @default(0)
  curp                   String?
  distanceToWork         Float?
  educationLevel         String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  employeeId             String?                   @unique
  employeeType           String                    @default("EMPLOYEE")
  experience             Json?                     @default("[]")
  fieldOfStudy           String?
  gender                 String?
  homeAddress            String?
  identificationNumber   String?
  isInstructor           Boolean                   @default(false)
  jobTitle               String?                   @default("Colaborador")
  managerId              String?
  maritalStatus          String?
  mobilePhone            String?
  nationality            String?
  passportNumber         String?
  pinCode                String?
  privateEmail           String?
  privatePhone           String?
  school                 String?
  skills                 Json?                     @default("[]")
  socialSecurityNumber   String?
  tags                   String?
  visaExpiry             DateTime?
  visaNumber             String?
  workPermitNumber       String?
  workPhone              String?
  EmployeeBenefit        EmployeeBenefit[]
  assetAssignments       AssetAssignment[]
  attendances            Attendance[]
  erp_digital_access     erp_digital_access[]
  erp_digital_signatures erp_digital_signatures[]
  absencesES             EmployeeAbsenceES[]
  erp_employee_assets    erp_employee_assets[]
  erp_employee_schedules erp_employee_schedules[]
