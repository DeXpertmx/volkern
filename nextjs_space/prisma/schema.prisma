  @@index([cursoId])
  @@index([orden])
}

model Leccion {
  id                 String            @id @default(cuid())
  moduloId           String
  titulo             String
  descripcion        String?
  contenido          String?
  videoUrl           String?
  duracionMinutos    Int?
  materialesUrl      Json?
