  @@map("sales_playbook_entries")
}

model Supplier {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  taxId        String?
  email        String?
  phone        String?
  streetType   String?
  streetName   String?
  streetNumber String?
  staircase    String?
  floor        String?
  door         String?
  postalCode   String?
  city         String?
  province     String?
  country      String?
  category     String
  balance      Float     @default(0)
  active       Boolean   @default(true)
  // Tipos de IVA que aplica este proveedor (p. ej. [21, 10, 4]). Un
  // proveedor puede facturar a varios tipos; al registrar un gasto se
  // ofrecen como opciones para el IVA del documento.
  vatRates     Float[]   @default([])
  // ── Trato fiscal (retenciones por ley) ───────────────────────────────
  // fiscalRegime: régimen legal del proveedor que determina las retenciones
  //   aplicables al pagarle (IRPF/IVA). Presets: EMPRESA (sin retención),
  //   PROFESIONAL (IRPF 15%), PRIMER_ANO (IRPF 7%), ARRENDADOR (IRPF 19%)
  //   y CUSTOM (porcentajes manuales).
  fiscalRegime String  @default("EMPRESA")
  // Porcentaje de retención IRPF aplicable (p. ej. 15 → 15%).
  irpfRetention Float  @default(0)
  // Porcentaje de retención de IVA aplicable (casos legales específicos,
  // p. ej. 1 → 1%).
  ivaRetention  Float  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expenses      Expense[]
  compras       Compra[] @relation("CompraProveedor")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([category])
  @@map("erp_suppliers")
}

// Plantilla de lectura aprendida por proveedor: regiones (coordenadas
// relativas 0..1 sobre la imagen) donde cada campo de la factura aparece
// siempre. Se aprende cuando el usuario corrige un escaneo señalando en la
// imagen dónde está cada dato; en el siguiente escaneo del mismo proveedor
// el sistema extrae los campos desde esas regiones en lugar de fiarse solo
// del parser genérico.
model SupplierOcrTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  // Proveedor al que pertenece la plantilla (nombre tal y como aparece en el OCR)
  supplierName String
  // NIF del proveedor si se conoce (clave secundaria de coincidencia)
  nif          String?
  // Nombre del formato (p. ej. "Factura estándar", "Sucursal Madrid") — un
  // mismo proveedor puede tener varias plantillas para formatos distintos
  name         String   @default("Formato 1")
  // [{ field, label, x, y, w, h }] — coordenadas relativas 0..1
  fields       Json
  // [{ rate: {x,y,w,h}, base: {x,y,w,h}, cuota: {x,y,w,h}, reference?, page? }]
  // Posiciones de las columnas de cada fila de impuestos, aprendidas al
  // confirmar los tramos tras el escaneo (asociación posicional de IVA).
  vatRows      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierName, name])
  @@index([tenantId, nif])
  @@map("erp_supplier_ocr_templates")
}

model Expense {
  id                 String   @id @default(cuid())
  tenantId           String
  createdById        String
  supplierId         String
  leadId             String?
  description        String
  amount             Float
  currency           String   @default("EUR")
  date               DateTime @default(now())
  dueDate            DateTime?
  paymentMethod      String?
  status             String   @default("PAID")
  category           String
  receiptUrl         String?
  metadata           Json?    @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  projectId          String?
  exifLat            Float?
  exifLng            Float?
  fingerprint        String?  @unique
  isAnomaly          Boolean  @default(false)
  parentFingerprint  String?
  verificationStatus String   @default("PENDING")
  // Atribución opcional a hospitality (FASE 3.B, "sin duplicar entidades"):
  // un gasto del ERP (limpieza externa, incidencia, consumibles…) puede
  // imputarse a una reserva concreta para calcular su rentabilidad real.
  hospitalityReservationId String?

  /// Cuándo este gasto dejó de ser una estimación y quedó atado a la factura
  /// del proveedor que lo justifica. `null` = sigue provisional (por ejemplo el
  /// coste que genera un pedido de compra al recibirse). Evita contabilizar dos
  /// veces el mismo suministro: la factura completa este gasto en vez de crear otro.
  reconciledAt       DateTime?

  // ── Verifactu ─────────────────────────────────────────────
  invoiceNumber      String?  // Número y serie de la factura
  taxableBase        Float?   // Base imponible
  vatRate            Float?   // Tipo de IVA aplicado (%)
  vatAmount          Float?   // Cuota total de IVA
  operationDate      DateTime? // Fecha de la operación (si distinta a emisión)
  issuerName         String?  // Razón social del emisor
  issuerAddress      String?  // Domicilio fiscal del emisor
  issuerTaxId        String?  // NIF del emisor

  createdBy          User     @relation("ExpenseCreator", fields: [createdById], references: [id])
  compra             Compra?  @relation("CompraGasto")
  lead               Lead?    @relation(fields: [leadId], references: [id])
  project            Project? @relation(fields: [projectId], references: [id])
  supplier           Supplier @relation(fields: [supplierId], references: [id])
  hospitalityReservation HospitalityReservation? @relation("ExpenseHospitalityReservation", fields: [hospitalityReservationId], references: [id], onDelete: SetNull)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supplierId])
  @@index([leadId])
  @@index([category])
  @@index([status])
  @@index([date])
  @@index([hospitalityReservationId])
  @@index([tenantId, supplierId, reconciledAt])
  @@map("erp_expenses")
}

