model Campaign {
  id                 String              @id @default(cuid())
  nombre             String
  descripcion        String?
  tipo               String              @default("manual")
  estado             String              @default("borrador")
  canales            String[]
  targetType         String              @default("todos")
  targetConfig       Json?
  fechaProgramada    DateTime?
  frecuencia         String?
  fechaFin           DateTime?
  totalDestinatarios Int                 @default(0)
  totalEnviados      Int                 @default(0)
  totalEntregados    Int                 @default(0)
  totalAbiertos      Int                 @default(0)
  totalClicks        Int                 @default(0)
  totalConversiones  Int                 @default(0)
  totalErrores       Int                 @default(0)
  fechaCreacion      DateTime            @default(now())
  fechaActualizacion DateTime            @updatedAt
  fechaInicio        DateTime?
  fechaCompletado    DateTime?
  tenantId           String?
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions         CampaignExecution[]
  mensajes           CampaignMessage[]
  metrics            CampaignMetrics[]
  campaignLeads      CampaignLead[]

  @@index([tenantId])
  @@index([estado])
  @@index([tipo])
  @@index([fechaProgramada])
  @@index([fechaCreacion])
}

model CampaignMessage {
  id                 String   @id @default(cuid())
  campaignId         String
  canal              String
  asunto             String?
  contenido          String
  mediaUrl           String?
  plantillaId        String?
