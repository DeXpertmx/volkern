  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  aseguradoraId   String
  aseguradora     Aseguradora             @relation(fields: [aseguradoraId], references: [id], onDelete: Cascade)

  nombre          String
  ramo            Ramo
  subramo         String?
  descripcion     String?
  primaReferencia Decimal?
  comisionPct     Decimal?
  activo          Boolean                 @default(true)

  polizas         Poliza[]
  oportunidades   OportunidadComercial[]

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([tenantId, aseguradoraId, nombre])
  @@index([tenantId, ramo])
  @@index([aseguradoraId])
  @@map("insurance_productos_seguro")
}

// ─── Poliza ───────────────────────────────────────────────────────────────────

model Poliza {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones
  clienteId           String
  cliente             Contact             @relation("PolizaCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  aseguradoraId       String
  aseguradora         Aseguradora         @relation(fields: [aseguradoraId], references: [id], onDelete: Cascade)
  productoSeguroId    String
  productoSeguro      ProductoSeguro      @relation(fields: [productoSeguroId], references: [id], onDelete: Cascade)

  // Datos de la póliza
  numeroPoliza        String
  descripcion         String?
  sumaAsegurada       Decimal?
  primaAnual          Decimal?
  formaPago           FormaPago?
  moneda              String              @default("EUR")

  // Fechas clave
  fechaInicio         DateTime
  fechaVencimiento    DateTime
  fechaEmision        DateTime            @default(now())

  // Estado
  estado              EstadoPoliza        @default(ACTIVA)

  // Metadata
  comisionPct         Decimal?
  notas               String?

  // Tracking
  renovaciones        Renovacion[]
  oportunidades       OportunidadComercial[]  @relation("OportunidadPolizaOrigen")
  siniestros          Siniestro[]

  // Auditoría
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdById         String
  createdBy           User                @relation("PolizaCreator", fields: [createdById], references: [id])

  @@unique([tenantId, numeroPoliza])
  @@index([tenantId, estado])
  @@index([tenantId, fechaVencimiento])
  @@index([tenantId, productoSeguroId])
  @@index([tenantId, aseguradoraId])
  @@index([clienteId])
  @@map("insurance_polizas")
}

// ─── Renovacion ───────────────────────────────────────────────────────────────

model Renovacion {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

