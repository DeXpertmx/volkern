  @@index([moduloId])
  @@index([orden])
  @@index([quizId])
  @@index([tareaId])
}

model Inscripcion {
  id                   String     @id @default(cuid())
  estudianteId         String
  cursoId              String
  fechaInscripcion     DateTime   @default(now())
  fechaExpiracion      DateTime?
  estado               String     @default("activo")
  montoPagado          Float?
  stripePaymentId      String?
  hotmartTransactionId String?
  metodoPago           String?
  progresoPorcentaje   Float      @default(0)
  fechaUltimoAcceso    DateTime?
  certificadoGenerado  Boolean    @default(false)
  cuponUsado           String?
  fechaActualizacion   DateTime   @default(now()) @updatedAt
  fechaCompletado      DateTime?
  leccionesCompletadas Int        @default(0)
  puntuacionFinal      Float?
  stripeSubscriptionId String?
  tipoAcceso           String     @default("compra")
  totalLecciones       Int        @default(0)
  ultimaLeccionId      String?
  insigniasGanadas     String[]
  puntosObtenidos      Int        @default(0)
