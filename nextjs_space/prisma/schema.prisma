  @@unique([bundleId, cursoId])
  @@index([bundleId])
  @@index([cursoId])
}

model Conversation {
  id                 String      @id @default(cuid())
  contactoNombre     String
  contactoEmail      String?
  contactoTelefono   String?
  canal              String
  estado             String      @default("abierta")
