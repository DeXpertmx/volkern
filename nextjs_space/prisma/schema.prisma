model AuditLog {
  id             String   @id @default(cuid())
  tenantId       String?
  userId         String?
  accion         String
  entidad        String
  entidadId      String
  descripcion    String
  cambiosAntes   Json?
  cambiosDespues Json?
  ipAddress      String?
  userAgent      String?
  fechaCreacion  DateTime @default(now())
  hash           String?
  metadata       Json?    @default("{}")
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([entidad])
  @@index([entidadId])
  @@index([fechaCreacion])
  // Índice compuesto requerido por los queries en `lib/compliance-score.ts`:
  //   • scoreAlertas:        where:{tenantId, accion:'COMPLIANCE_BLOCKED', fechaCreacion:{gte:...}}
  //   • getTrend:            where:{tenantId, accion:'COMPLIANCE_SCORE'}, orderBy:{fechaCreacion:'desc'}
  // Sin este índice, ambas queries degradan a Seq Scan cuando AuditLog tenga
  // >~100k filas. Cobertura: cualquier filtro por (tenantId, accion) con
  // rango temporal puede usarlo como Index Scan.
  @@index([tenantId, accion, fechaCreacion])
}

