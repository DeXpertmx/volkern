// ─── InsuranceImportLog (para auditoría del importador) ───────────────────────

model InsuranceImportLog {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fileName        String
  fileType        String    // xlsx, csv
  totalRows       Int
  rowsImported    Int
  rowsFailed      Int
  errors          Json?     // Array de errores por fila
  summary         Json?     // Resumen: polizas creadas, aseguradoras nuevas, etc.

  createdById     String
  createdBy       User      @relation("ImportLogCreator", fields: [createdById], references: [id])

  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("insurance_import_logs")
}

// ─── PortfolioForecastLog (auditoría de predicciones del forecast ejecutivo) ──
// Cada GET a /api/insurance/portfolio/forecast persiste una fila. Cuando el mes
// proyectado ya pasó, permite backfillear el valor real y calcular MAPE.
// Constraint única (tenantId, mesProyectado, sourceVersion) garantiza idempotencia:
//   - el mismo (tenant, mes) genera siempre la misma fila aunque se llame N veces
//   - distintas versiones del modelo conviven en la misma tabla para comparar
model PortfolioForecastLog {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation("TenantForecastLogs", fields: [tenantId], references: [id], onDelete: Cascade)

  // Bucket (YYYY-MM-01 UTC) al que apunta la proyección ("el próximo mes").
  mesProyectado     DateTime
  // Valor numérico proyectado por el modelo en el instante de generación.
  proyectado        Decimal   @db.Decimal(18, 2)
  // Valor real backfilleado cuando el mes proyectado ya terminó. NULL hasta entonces.
  real              Decimal?  @db.Decimal(18, 2)
  // |proyectado - real| / max(real, 1) * 100 — error porcentual absoluto.
  // Se computa al backfillear `real` para no tener que hacerlo en cada lectura.
  errorPct          Decimal?  @db.Decimal(7, 2)

  // Metadatos del modelo: pendiente, intercepto, R² y ventana en meses.
  slope             Decimal?  @db.Decimal(18, 4)
  intercepto        Decimal?  @db.Decimal(18, 4)
  r2                Decimal?  @db.Decimal(7, 4)
  ventanaMeses      Int       @default(6)

  // Versión del modelo: si cambian los hiperparámetros del forecast, permite
  // mantener separadas las filas antiguas para auditoría/A/B.
  sourceVersion     String    @default("v1-linear-6m")

  generadoEn        DateTime  @default(now())
  backfilledEn      DateTime?

  // ─── Proactive alert side-effects (forecast → chatbot) ───
  // Cuando el forecast detecta slope<0 y R²>0.4, abre una conversación
  // proactiva con el chatbot. Estos campos guardan el "ya lo hicimos"
  // para idempotencia: si la alerta ya se disparó en los últimos 7 días,
  // no repetimos.
  alertaEnviadaAt        DateTime?
  alertaConversacionId   String?

  @@unique([tenantId, mesProyectado, sourceVersion])
  @@index([tenantId])
  @@index([generadoEn])
  @@index([real])
  @@index([alertaEnviadaAt])
  @@map("portfolio_forecast_log")
}

// ─── PortfolioSeasonalMultiplier (aprendido del histórico) ────────────────
// Multiplier estacional aprendido por tenant × evento × ramo. Computado al
// vuelo cuando el endpoint /forecast/smart lo necesita, persistido para no
// recalcular cada vez que alguien refresca el dashboard. Constraint única
// (tenantId, eventoKey, ramo) garantiza idempotencia del upsert.
model PortfolioSeasonalMultiplier {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation("TenantSeasonalMultipliers", fields: [tenantId], references: [id], onDelete: Cascade)

  // Identificador semántico del evento. Catálogo cerrado (seasonal-calendar.ts):
  //   SEMANA_SANTA, VUELTA_COLE, FIN_ANO, BUEN_FIN, VERANO, RAMO_RENOVACION
  eventoKey         String
  // Multiplier específico por ramo; NULL = global del tenant.
  ramo              String?

  // Ventana del evento en MMDD (mes*100+día) para emparejar el bucket
  // del forecast contra el rango histórico (rango recurrente, ejemplo: 1201..1231).
  ventanaMdInicio   Int
  ventanaMdFin      Int

  // Multiplier aprendido (1.30 = +30% sobre el baseline). DECIMAL(4,2) admite
  // desde 0.01 (estacionalidad muy deпреsiva) hasta 9.99 (pico extremo).
  multiplier        Decimal  @db.Decimal(4, 2)
  // Baseline promedio del mes base usado para normalizar (para debugging).
  baselinePrima     Decimal? @db.Decimal(18, 2)
  // Años donde se observó el evento (mínimo 2 para ser válido).
  muestras          Int
  // Confianza 0..1: nº de años ÷ cobertura esperada ×(1 - varianza relativa).
  confianza         Decimal? @db.Decimal(4, 2)

  fuente            String   @default("learned") // "learned" | "static" | "google_calendar"
  computedAt        DateTime @default(now())

  @@unique([tenantId, eventoKey, ramo])
  @@index([tenantId])
  @@index([eventoKey])
  @@map("portfolio_seasonal_multipliers")
}

// ─── Siniestro (Fase 5.1) ─────────────────────────────────────────────────────
// Ciclo de vida de un siniestro de seguros. Relación 1:N desde Poliza.
// Por qué está separado de Poliza: el mismo Poliza puede tener varios siniestros
// a lo largo del tiempo (auto con 2 choques, hogar con 2 inundaciones, etc.) y
// cada uno tiene su propio estado, monto reclamado y resolución.

enum EstadoSiniestro {
  REPORTADO        // Cliente acaba de avisar; todavía sin abrir officially
  EN_TRAMITE       // Documentación entregada, esperando respuesta aseguradora
  ABIERTO          // Aseguradora aceptó y está procesando
  PAGADO           // Aseguradora pagó la indemnización
  RECHAZADO        // Aseguradora rechazó el siniestro
  CERRADO          // Ciclo completo cerrado sin pago
}

model Siniestro {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones
  polizaId            String
  poliza              Poliza              @relation(fields: [polizaId], references: [id], onDelete: Cascade)
  clienteId           String
  cliente             Contact             @relation("SiniestroCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  aseguradoraId       String
  aseguradora         Aseguradora         @relation(fields: [aseguradoraId], references: [id], onDelete: Cascade)

  // Datos del siniestro
  numeroSiniestro     String?             // Número que devuelve la aseguradora (si aplica)
  descripcion         String
  fechaSuceso         DateTime            // Cuándo ocurrió el evento
  fechaReporte        DateTime            // Cuándo el cliente avisó (default: ahora)
  fechaCierre         DateTime?

  // Económico
  montoReclamado      Decimal?
  montoIndemnizado    Decimal?
  deducible           Decimal?
  moneda              String              @default("EUR")

  // Estado y trazabilidad
  estado              EstadoSiniestro     @default(REPORTADO)
  motivoRechazo       String?
  notas               String?
  documentos          Json?               // Array de URLs a PDFs/fotos del siniestro

  // Auditoría
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdById         String
  createdBy           User                @relation("SiniestroReporter", fields: [createdById], references: [id])

  @@unique([tenantId, numeroSiniestro])
  @@index([tenantId, estado])
  @@index([tenantId, fechaSuceso])
  @@index([polizaId])
  @@index([clienteId])
  @@index([aseguradoraId])
  @@map("insurance_siniestros")
}

model ConnectivityProvider {
  id                    String    @id @default(cuid())
  providerKey           String    @unique
  nombreVisible         String
  baseUrl               String
  partnerIdEnc          String?
  usernameEnc           String?
  passwordEnc           String?
  estado                String    @default("sin_configurar")
  ultimaSincronizacion  DateTime?
  ultimoEvento          DateTime?
  /// Health-check diario: última verificación activa (sonda property_details).
  /// Persistido (no solo memoria del proceso): la marca sobrevive reinicios y
  /// la puede leer también la API sin pasar por el store del cron.
  ultimaVerificacion    DateTime?
  contadorErrores       Int       @default(0)
  configuracion         Json?
  fechaCreacion         DateTime  @default(now())
  fechaEdicion          DateTime  @updatedAt

  @@index([estado])
  @@map("connectivity_providers")
}

// ─── Hospitality (Volkern Hospitality) ───────────────────────────────────
// Modelos del módulo de gestión de propiedades (reservas, huéspedes, canales).
// Regla de aislamiento: toda entidad lleva tenantId y los IDs externos de
// proveedores NUNCA son la identidad principal (ver ConnectivityMapping).

model HospitalityProperty {
  id             String    @id @default(cuid())
  tenantId       String
  nombre         String
  descripcion    String?
  codigo         String?
  zona           String?
  direccion      String?
  ciudad         String?
  estadoProvincia String?
  pais           String?
  cp             String?
  latitud        Float?
  longitud       Float?
  fotos          Json?
  /**
   * Datos del establecimiento ante SES.HOSPEDAJES: el código oficial que el
   * Ministerio asigna al darlo de alta (y, opcionalmente, su municipio INE).
   * Es referencia externa, nunca identidad interna de Volkern.
   */
  sesHospedajes  Json?
  /**
   * Detalle declarado del COMPLEJO para el editor estilo Airbnb:
   * `{ habitaciones: Record<id, n>, camas: Record<id, n>, servicios: string[] }`.
   * Los ids son del catálogo de lib/hospitality/property-editor-config.ts.
   * Desde el reencuadre propiedades↔unidades (migración 20261006120000),
   * `habitaciones`/`camas` son el AGREGADO de las unidades de la propiedad
   * (solo lectura; la API lo pisa al guardar, ver `encogerDetalleAServicios`)
   * y lo editable aquí son los `servicios`: las áreas comunes e instalaciones
   * del complejo (piscina, oficina de visitantes, estacionamiento…) que
   * comparten todos los huéspedes. La distribución de cada unidad vive en
   * `HospitalityUnit.detalleAlojamiento`.
   */
  detalleAlojamiento Json?
  /**
   * Ubicación enriquecida para el huésped (editor estilo Airbnb):
   * - `distancias`: { aeropuertoKm, autobusKm, metroKm, trenKm, autopistaKm,
   *   puertoKm, unidad } — distancias a transporte (unidad: 'km'|'millas').
   * - `indicaciones`: Record<idioma, texto> — cómo llegar, multi-idioma
   *   ('es', 'en'…). Texto plano: se renderiza con saltos de línea.
   * - `mapaPersonalizadoUrl`: imagen o mapa propio subido por el operador.
   * Los tres son opcionales (null = sin configurar) y se publican en las
   * comunicaciones de llegada y la ficha del booking engine.
   */
  distancias           Json?
  indicaciones         Json?
  mapaPersonalizadoUrl String?
  timezone       String    @default("America/Mexico_City")
  estado         String    @default("activa")
  // Penalización por no-show de esta propiedad: ninguna|primera_noche|estancia_completa.
  // El no-show NO ocupa la unidad (regla 7 del plan); esto solo decide qué se cobra.
  politicaNoShow String    @default("primera_noche")
  // Salida anticipada (decisión del Anfitrión, docs/hospitality-estados-auditoria.md):
  // cerrar_estancia = A (el check-out pone el checkOut al día en curso y libera las
  // noches no usadas pisando las fechas previstas) | salida_real = B (se guarda
  // checkOutReal y la disponibilidad/ocupación usa min(checkOut, checkOutReal),
  // dejando checkOut para las noches vendidas y la facturación).
  politicaSalidaAnticipada String @default("salida_real")
  // Horas que un hold `pending` retiene la unidad antes de caducar solo
  // (docs/hospitality-estados-auditoria.md §holds). 0 = sin caducidad
  // automática: el hold solo lo cierra una persona. Con pagos registrados
  // nunca caduca (es una decisión humana, no un barrido). Ver lib/hospitality/holds.ts.
  holdHoras      Int       @default(24)
  fechaCreacion  DateTime  @default(now())
  fechaEdicion   DateTime  @updatedAt
  tenant         Tenant    @relation("HospitalityProperties", fields: [tenantId], references: [id], onDelete: Cascade)
  units          HospitalityUnit[]
  ratePlans      HospitalityRatePlan[]
  mappings       ConnectivityMapping[]
  reservations   HospitalityReservation[]
  syncLogs       HospitalitySyncLog[]
  reservationItems HospitalityReservationItem[]
  payments       HospitalityPayment[]
  extras         HospitalityExtra[]
  fees           HospitalityFee[]

  // Código de establecimiento asignado por el Sistema de Hospedajes del
  // Ministerio del Interior en el momento del registro de la entidad. Es el
  // `codigoEstablecimiento` que exige el XSD de alta de partes de viajeros
  // (arts. 3.1.1.1 de la interfaz v3.1.2). Null = todavía sin registrar.
  codigoEstablecimientoMIR String?

  reviews HospitalityReview[] @relation("HospitalityReviews")
  // Credenciales de conectividad de esta propiedad, una por proveedor.
  connectivityConfigs HospitalityConnectivityPropertyConfig[] @relation("HospitalityConnectivityPropertyConfigs")
  // Hilos de mensajería del canal de esta propiedad.
  canalConversaciones HospitalityCanalConversacion[] @relation("HospitalityCanalConversacionesProperty")

  @@index([tenantId])
  @@map("hospitality_properties")
}

model HospitalityUnit {
  id            String                   @id @default(cuid())
  tenantId      String
  propertyId    String
  nombre        String
  codigo        String?
  tipo          String    @default("apartamento")
  capacidad     Int       @default(2)
  tarifaBase    Float?
  moneda        String    @default("MXN")
  descripcion   String?
  fotos         Json?
  amenidades    Json?
  /**
   * Detalle declarado de ESTA unidad (editor estilo Airbnb):
   * `{ habitaciones: Record<id, n>, camas: Record<id, n> }` — misma forma que
   * el de la propiedad, sin `servicios` (en la unidad el catálogo vivo es
   * `amenidades`). Cada unidad de un complejo tiene su propia distribución:
   * habitaciones y camas viven aquí, no en la propiedad (sus valores vienen
   * del backfill de la migración 20261006120000 para las que nunca declararon
   * los suyos). Se normaliza con los helpers de `lib/hospitality/unit-detalle.ts`.
   */
  detalleAlojamiento Json?
  estado        String    @default("available") // available|occupied|cleaning|dirty|maintenance|out_of_service
  fechaCreacion DateTime  @default(now())
  fechaEdicion  DateTime  @updatedAt
  tenant        Tenant    @relation("HospitalityUnits", fields: [tenantId], references: [id], onDelete: Cascade)
  property      HospitalityProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mappings      ConnectivityMapping[]
  ratePlans     HospitalityRatePlan[]
  reservations  HospitalityReservation[]
  cleaningTasks HospitalityCleaningTask[]
  maintenanceTasks HospitalityMaintenanceTask[]
  manualBlocks HospitalityUnitBlock[]
  reservationItems HospitalityReservationItem[]
  payments       HospitalityPayment[]
  reviews        HospitalityReview[] @relation("HospitalityReviews")

  @@index([tenantId])
  @@index([propertyId])
  @@unique([tenantId, codigo])
  @@map("hospitality_units")
}

// Plan de tarifa por unidad (plan maestro §6, §15): tarifa por noche y
// restricciones de venta. `codigo` es el identificador del rate plan en la
// capa de conectividad (rateplanCode) cuando existe mapping; nunca es la PK
// interna de Volkern.
model HospitalityRatePlan {
  id            String    @id @default(cuid())
  tenantId      String
  propertyId    String
  unitId        String
  nombre        String
  codigo        String? // rateplanCode externo si aplica (solo mapping)
  tarifa        Float // precio por noche
  moneda        String    @default("MXN")
  minNoches     Int       @default(1)
  maxNoches     Int? // null = sin máximo
  // Días de la semana permitidos para check-in / check-out (0=domingo ... 6=sábado).
  // null o [] = sin restricción de día.
  checkInDias   Json?
  checkOutDias  Json?
  // Estacionalidad (capa 1 del pricing): configuración por fecha del precio.
  // `temporadas`: rangos {desde, hasta, tarifa, nombre?} con precio ABSOLUTO
  // por noche; `finDeSemana`: {dias: number[], porcentaje} recargo sobre la
  // tarifa de noches SIN temporada. La regla central: el precio se aplica por
  // NOCHE (la noche cuesta la tarifa de su fecha), y un plan sin ninguna de
  // las dos capas sigue cotizando con su `tarifa` plana de siempre. El Json se
  // normaliza con normalizarEstacionalidad() antes de usarse: un rango
  // malformado se descarta, nunca tumba una cotización.
  temporadas    Json?
  finDeSemana   Json?
  // Ajustes de precio (capa 2 del pricing dinámico): reglas de ANTELACIÓN
  // (días entre la reserva y la llegada), OCUPACIÓN (cómo de llena está la
  // propiedad esa noche) y DURACIÓN (noches de la estancia) que modifican
  // porcentualmente la tarifa por noche que ya resolvió la capa 1. La forma
  // —tramos, precedencia y suelo/techo del factor— vive en
  // lib/hospitality/ajustes.ts y se normaliza antes de usarse (una pieza
  // malformada se descarta y el plan cotiza como si no tuviera ajustes).
  // SOLO reserva directa: un calendario de tarifas por fecha no puede expresar
  // "si se reserva con 30 días de antelación", así que el push a canales sigue
  // empujando la tarifa publicada de la capa 1.
  ajustes       Json?
  activo        Boolean   @default(true)
  fechaCreacion DateTime  @default(now())
  fechaEdicion  DateTime  @updatedAt
  tenant        Tenant    @relation("HospitalityRatePlans", fields: [tenantId], references: [id], onDelete: Cascade)
  property      HospitalityProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit          HospitalityUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([unitId])
  @@map("hospitality_rate_plans")
}

// Mapeo entre entidades Volkern y los identificadores externos del proveedor
// de conectividad (propiedad, habitación, plan de tarifa). El código externo
// es un ID de integración, nunca la PK interna de Volkern.
model ConnectivityMapping {
  id                  String    @id @default(cuid())
  tenantId            String
  propertyId          String?
  unitId              String?
  provider            String    @default("channel_connectivity")
  externalPropertyId  String
  externalUnitCode    String?
  externalRatePlanCode String?
  estado              String    @default("activo")
  metadata            Json?
  fechaCreacion       DateTime  @default(now())
  fechaEdicion        DateTime  @updatedAt
  tenant              Tenant    @relation("HospitalityMappings", fields: [tenantId], references: [id], onDelete: Cascade)
  property            HospitalityProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit                HospitalityUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([provider, externalPropertyId, externalUnitCode])
  @@index([tenantId])
  @@index([propertyId])
  @@index([unitId])
  @@map("connectivity_mappings")
}

// ID de socio (partner id) del proveedor de conectividad, POR TENANT.
//
// El proveedor emite un partner id al registrarse cada hotel, y ese id es la
// clave con la que se piden SUS propiedades (`property_details/{hotelCode}`
// viaja con `?partnerId=`). Sin el suyo, el hotel no puede ver su catálogo ni
// empujar inventario: la fila de plataforma (`ConnectivityProvider`) sirve el
// par Basic y su partner id solo como RESPALDO de quien no tenga el propio.
//
// El valor se guarda cifrado y se escribe desde el dashboard del cliente; la
// pantalla de plataforma (`/admin/conectividad`) sigue siendo la única que
// administra el usuario y la contraseña, que son compartidos.
model HospitalityConnectivityConfig {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  partnerIdEnc   String?
  activo         Boolean  @default(true)
  fechaCreacion  DateTime @default(now())
  fechaEdicion   DateTime @updatedAt
  tenant         Tenant   @relation("HospitalityConnectivityConfigs", fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("hospitality_connectivity_config")
}

// Credencial de conectividad POR PROPIEDAD y PROVEEDOR.
//
// Hace falta porque NOBEDS emite **un token por hotel** y lo exige en la ruta de
// cada llamada, mientras que `HospitalityConnectivityConfig.partnerIdEnc` es un
// único identificador **por tenant**: sirve para el proveedor actual y no para
// multi-propiedad.
//
// Convive con el modelo anterior durante la migración (el campo `provider` de
// `ConnectivityMapping` ya permitía dos proveedores a la vez). La regla de quién
// escribe la decide `lib/hospitality/conectividad-proveedores.ts`, no esta tabla:
// aquí se guarda la credencial, allí se prohíbe que haya dos escritores sobre la
// misma propiedad.
model HospitalityConnectivityPropertyConfig {
  id                 String    @id @default(cuid())
  tenantId           String
  propertyId         String
  /// `nobeds` | `channel_connectivity`. Ver `ProveedorConectividad`.
  provider           String
  /// Código de la propiedad en el proveedor (`hotel_id` / `hotelCode`).
  externalPropertyId String
  /// Token cifrado. En NOBEDS viaja en la URL de cada petición: nunca se
  /// registra, ni se devuelve por API, ni se pinta en una pantalla.
  tokenEnc           String?
  /// `true` = esta credencial puede usarse. La política de escritura lo respeta
  /// y, además, exige que no haya otro proveedor activo con escritura.
  activo             Boolean   @default(false)
  /// `escritura` | `lectura`. Un proveedor activo escribe salvo que se marque
  /// `lectura`: es el modo en que el proveedor anterior se queda en paralelo
  /// durante la migración (lee y reconcilia, no empuja).
  modo               String    @default("escritura")
  estado             String    @default("sin_configurar")
  ultimoChequeo      DateTime?
  /// Último error de la sonda, saneado (sin token ni URL con credenciales).
  ultimoError        String?
  configuracion      Json?
  fechaCreacion      DateTime  @default(now())
  fechaEdicion       DateTime  @updatedAt
  tenant             Tenant    @relation("HospitalityConnectivityPropertyConfigs", fields: [tenantId], references: [id], onDelete: Cascade)
  property           HospitalityProperty @relation("HospitalityConnectivityPropertyConfigs", fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId, provider])
  @@index([tenantId])
  @@index([provider, estado])
  @@map("hospitality_connectivity_property_config")
}

model HospitalityReservation {
  id                    String    @id @default(cuid())
  tenantId              String
  propertyId            String
  unitId                String?
  contactId             String?
  // Referencias externas: bookingId = OTA, cmBookingId = channel manager.
  // Nunca son la identidad principal; la única clave es id + tenantId.
  channel               String
  externalBookingId     String
  cmBookingId           String?
  action                String    @default("book")
  estado                String    @default("confirmed") // pending|confirmed|cancelled|checked_in|checked_out|no_show
  checkIn               DateTime
  checkOut              DateTime
  // Salida REAL del huésped (check-out anticipado, opción B): null = no ha
  // salido o salió el día previsto. La ocupación usa min(checkOut, checkOutReal)
  // vía finEstanciaReal(); checkOut queda intacto para noches vendidas y facturación.
  checkOutReal          DateTime?
  bookedOn              DateTime?
  segment               String?
  specialRequests       String?
  pah                   Boolean   @default(false)
  amountAfterTax        Float?
  amountBeforeTax       Float?
  tax                   Float?
  currency              String    @default("MXN")
  commission            Float?
  tcs                   Float?
  tds                   Float?
  occupancyAdults       Int       @default(1)
  occupancyChildren     Int       @default(0)
  guestData             Json?
  // Respuestas del huésped a las preguntas personalizadas del check-in
  // ({preguntaId: valor}), para el hotel. Viven fuera de `guestData.viajeros`
  // a propósito: nada de lo que el huésped conteste aquí entra en el XML del
  // parte que se comunica al Ministerio (el XSD es cerrado).
  respuestasCheckin     Json?
  payload               Json?
  // Token público del check-in online (registro de viajeros): es el enlace que
  // se le manda al huésped para que suba los documentos de su grupo. Opaco y
  // único — quien lo tiene edita esa reserva y solo esa, así que no se puede
  // adivinar (cuidado: no exponerlo en respuestas de listado).
  tokenCheckin          String?   @unique
  // Token público de la reseña (solicitud §21): el enlace del email que le
  // llega al huésped tras el check-out. Mismo patrón que tokenCheckin: opaco,
  // único y por reserva — quien lo tiene escribe (o corrige) la reseña de esa
  // estancia y solo esa. Vive aquí y no en la reseña porque el cron lo genera
  // ANTES de que exista reseña (la reseña nace cuando el huésped envía).
  tokenResena           String?   @unique
  travelers             HospitalityTraveler[]     @relation("HospitalityReservationTravelers")
  compliance            HospitalityCompliance?    @relation("HospitalityReservationCompliance")
  fechaCreacion         DateTime  @default(now())
  fechaEdicion          DateTime  @updatedAt
  tenant                Tenant    @relation("HospitalityReservations", fields: [tenantId], references: [id], onDelete: Cascade)
  property              HospitalityProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit                  HospitalityUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  contact               Contact?             @relation("HospitalityReservationContact", fields: [contactId], references: [id], onDelete: SetNull)
  webhookEvents         HospitalityWebhookEvent[]
  cleaningTasks         HospitalityCleaningTask[]
  items                 HospitalityReservationItem[]
  payments              HospitalityPayment[]
  // Gastos del ERP imputados a esta reserva (limpieza externa, incidencias…).
  expenses              Expense[] @relation("ExpenseHospitalityReservation")
  // Comunicaciones al Ministerio del Interior generadas desde esta reserva.
  guestRegistryCommunications HospitalityGuestRegistryCommunication[]
  // La reseña de esta estancia (una sola por reserva, la moderación decide).
  review                HospitalityReview? @relation("HospitalityReviews")
  // Hilos de mensajería del canal colgados de esta reserva.
  canalConversaciones   HospitalityCanalConversacion[] @relation("HospitalityCanalConversacionesReservation")

  @@unique([tenantId, channel, externalBookingId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([unitId])
  @@index([estado])
  @@index([checkIn])
  @@index([externalBookingId])
  @@map("hospitality_reservations")
}

// Eventos brutos del proveedor de conectividad (auditoría/diagnóstico).
// Se registra SIEMPRE el payload recibido, incluso si falla la resolución.
model HospitalityWebhookEvent {
  id              String    @id @default(cuid())
  tenantId        String?
  reservationId   String?
  action          String
  channel         String?
  hotelCode       String?
  bookingId       String?
  estado          String    @default("recibido") // recibido|procesado|duplicado|error|sin_mapping
  errorMensaje    String?
  payload         Json?
  // Entregas acumuladas de ESTA fila. En las reservas vale 1 (una fila por
  // evento); en los mensajes sin mapping la fila es única por hotel+canal y
  // aquí se cuenta cada reintento del proveedor: «este código lleva 40 intentos
  // desde el 9-oct» es la información que hace falta para actuar, y 40 filas
  // idénticas no la dan mejor.
  intentos        Int       @default(1)
  // Momento del último reintento (null en las filas históricas de reservas).
  ultimoIntentoEn DateTime?
  fechaCreacion   DateTime  @default(now())
  tenant          Tenant?   @relation("HospitalityWebhookEvents", fields: [tenantId], references: [id], onDelete: Cascade)
  reservation     HospitalityReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([reservationId])
  @@index([bookingId])
  @@index([fechaCreacion])
  @@map("hospitality_webhook_events")
}

// Log de sincronización con la capa de conectividad (plan maestro §29/§30).
// Cada push (inventario/tarifas) deja una traza: qué, cuándo, qué propiedad,
// qué operación, respuesta externa y estado de procesamiento. Sin retries
// ciegos: un push fallido queda registrado con su causa para revisión manual.
model HospitalitySyncLog {
  id               String   @id @default(cuid())
  tenantId         String
  propertyId       String?
  tipo             String   // inventory|rates|inventory_restrictions|rates_restrictions|reconciliacion
  operacion        String   // reserva_creada|reserva_modificada|reserva_cancelada|unidad_cambiada|manual
  estado           String   @default("pendiente") // pendiente|exito|error
  httpStatus       Int?
  requestPayload   Json?
  responseBody     Json?
  errorMensaje     String?
  duracionMs       Int?
  fechaCreacion    DateTime @default(now())
  tenant           Tenant                    @relation("HospitalitySyncLogs", fields: [tenantId], references: [id], onDelete: Cascade)
  property         HospitalityProperty?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([propertyId])
  @@index([tipo])
  @@index([estado])
  @@index([fechaCreacion])
  @@map("hospitality_sync_logs")
}
// Estados: pending|in_progress|completed|blocked.
model HospitalityCleaningTask {
  id             String   @id @default(cuid())
  tenantId       String
  unitId         String
  reservationId  String?
  fecha          DateTime @default(now())
  prioridad      String   @default("normal") // baja|normal|alta
  responsable    String?
  estado         String   @default("pending") // pending|in_progress|completed|blocked
  notas          String?
  fechaCreacion  DateTime @default(now())
  fechaEdicion   DateTime @updatedAt
  tenant         Tenant                    @relation("HospitalityCleaningTasks", fields: [tenantId], references: [id], onDelete: Cascade)
  unit           HospitalityUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reservation    HospitalityReservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([unitId])
  @@index([estado])
  @@map("hospitality_cleaning_tasks")
}

// Incidencia de mantenimiento de una unidad alojativa (plan maestro §18.4).
// Estados: abierta|en_proceso|resuelta|cerrada.
model HospitalityMaintenanceTask {
  id             String   @id @default(cuid())
  tenantId       String
  unitId         String
  incidencia     String
  descripcion    String?
  prioridad      String   @default("media") // baja|media|alta|critica
  responsable    String?
  estado         String   @default("abierta") // abierta|en_proceso|resuelta|cerrada
  fecha          DateTime @default(now())
  notas          String?
  fechaCreacion  DateTime @default(now())
  fechaEdicion   DateTime @updatedAt
  tenant         Tenant                   @relation("HospitalityMaintenanceTasks", fields: [tenantId], references: [id], onDelete: Cascade)
  unit           HospitalityUnit          @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([unitId])
  @@index([estado])
  @@map("hospitality_maintenance_tasks")
}

// Bloqueo manual de fechas de una unidad alojativa (§17).
// Intervalo [fechaInicio, fechaFin): la fecha fin NO bloquea, igual que las
// reservas, para no tener dos reglas distintas en el inventario.
// No todo lo que ocupa una unidad es una reserva: el `tipo` distingue uso del
// propietario, mantenimiento y cierre administrativo. Las reservas (OTA, manual
// o Booking Engine) NO son bloqueos: son del Reservation Engine.
model HospitalityUnitBlock {
  id            String   @id @default(cuid())
  tenantId      String
  unitId        String
  fechaInicio   DateTime
  fechaFin      DateTime
  tipo          String   @default("propietario") // propietario|mantenimiento|administrativo
  motivo        String?
  estado        String   @default("activo") // activo|cancelado
  fechaCreacion DateTime @default(now())
  fechaEdicion  DateTime @updatedAt
  tenant        Tenant         @relation("HospitalityUnitBlocks", fields: [tenantId], references: [id], onDelete: Cascade)
  unit          HospitalityUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([unitId])
  @@index([fechaInicio, fechaFin])
  @@index([estado])
  @@map("hospitality_unit_blocks")
}

// ─── Finanzas de la reserva (FASE 3: Booking Engine + Payments) ──────────────
// El desglose vive en las líneas; la reserva conserva el total externo recibido
// de la OTA para poder conciliar sin perder el dato de origen.

// Extra comprable en el booking engine (desayuno, late check-out, traslado):
// catálogo por propiedad. El PRECIO vive aquí — el huésped elige, la ruta
// pública valida contra este catálogo y nunca usa el precio del cliente.
// precioPorNoche=true: el importe se multiplica por las noches de la estancia.
model HospitalityExtra {
  id             String   @id @default(cuid())
  tenantId       String
  propertyId     String
  nombre         String
  // Descripción bilingüe opcional para la web (el motor es ES/EN).
  descripcionEs  String?
  descripcionEn  String?
  precio         Float
  moneda         String   @default("MXN")
  precioPorNoche Boolean  @default(false)
  activo         Boolean  @default(true)
  orden          Int      @default(0)
  fechaCreacion  DateTime @default(now())
  fechaEdicion   DateTime @updatedAt
  tenant         Tenant                @relation("HospitalityExtras", fields: [tenantId], references: [id], onDelete: Cascade)
  property       HospitalityProperty   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // (la inversa `extras` vive en HospitalityProperty)

  @@index([tenantId])
  @@index([propertyId, activo])
  @@map("hospitality_extra")
}

// Tarifa adicional por estancia (limpieza, gestión, mascota, ropa de cama,
// resort, comunidad): lo que el huésped paga ADEMÁS del precio de las noches.
// A diferencia del extra, no es un producto del catálogo comercial sino un
// cargo de la propiedad: `obligatoria=true` entra en toda estancia (el huésped
// no puede quitarla) y `false` se ofrece para que la elija (mascota, cama
// extra). Se cobra UNA vez por estancia.
model HospitalityFee {
  id            String   @id @default(cuid())
  tenantId      String
  propertyId    String
  nombre        String
  descripcionEs String?
  descripcionEn String?
  importe       Float
  moneda        String   @default("MXN")
  obligatoria   Boolean  @default(true)
  activo        Boolean  @default(true)
  orden         Int      @default(0)
  fechaCreacion DateTime @default(now())
  fechaEdicion  DateTime @updatedAt
  tenant        Tenant              @relation("HospitalityFees", fields: [tenantId], references: [id], onDelete: Cascade)
  property      HospitalityProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId, activo])
  @@map("hospitality_fee")
}

// Código promocional del canal directo (FASE 3.D).
//
// Se aplica SOLO al alojamiento (nunca a extras ni a tarifas adicionales) y es
// del tenant, no de una propiedad: el hotel comunica «VERANO2027» y vale en
// todas sus webs publicadas. El descuento lo calcula siempre el servidor; la
// web solo manda el texto del código.
//
// `tipo`: `porcentaje` (valor 0–100) o `importe` (valor en `moneda`, nunca mayor
// que el alojamiento). `desde`/`hasta` acotan las fechas de ESTANCIA (día de
// entrada, ambos inclusive); `maxUsos` nulo = sin límite y `usos` es el contador
// que se incrementa al crear la reserva.
model HospitalityPromoCode {
  id            String    @id @default(cuid())
  tenantId      String
  codigo        String
  tipo          String    @default("porcentaje") // porcentaje|importe
  valor         Float
  moneda        String    @default("MXN")
  desde         DateTime?
  hasta         DateTime?
  minNoches     Int       @default(1)
  maxUsos       Int?
  usos          Int       @default(0)
  activo        Boolean   @default(true)
  descripcion   String?
  fechaCreacion DateTime  @default(now())
  fechaEdicion  DateTime  @updatedAt
  tenant        Tenant    @relation("HospitalityPromoCodes", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@map("hospitality_promo_code")
}

// Consulta de un código promocional en la web pública: la INTENCIÓN de usarlo.
// Una consulta que no acaba en reserva es un dato, no un descuento concedido:
// sin esta fila solo se vería la venta y no el intento, y la conversión de cada
// código sería invisible.
//
// `resultado` es «aplicada» cuando el código valía para la estancia, o el motivo
// exacto del rechazo (`inactiva`, `fuera_de_fecha`, `min_noches`, `agotada`,
// `sin_alojamiento`, `no_existe`). `sesionId` lo genera el asistente de reserva:
// permite que aplicar el código tres veces en la misma sesión cuente una sola
// consulta y que la reserva marque exactamente esa fila como convertida.
model HospitalityPromoConsulta {
  id            String    @id @default(cuid())
  tenantId      String
  codigo        String
  propertyId    String?
  unitId        String?
  checkIn       DateTime
  checkOut      DateTime
  resultado     String    @default("aplicada")
  motivo        String?
  sesionId      String?
  reservationId String?
  fecha         DateTime  @default(now())
  tenant        Tenant    @relation("HospitalityPromoConsultas", fields: [tenantId], references: [id], onDelete: Cascade)

  // Una consulta por sesión y código: reintentar no infla el denominador de la
  // conversión. `sesionId` nulo (integraciones sin sesión) no choca consigo mismo.
  @@unique([tenantId, sesionId, codigo])
  @@index([tenantId, codigo, checkIn])
  @@index([tenantId, checkIn])
  // Las alertas de conversión se leen por fecha de REGISTRO (una consulta para
  // dentro de seis meses es un intento de hoy), no por fecha de entrada.
  @@index([tenantId, fecha])
  @@map("hospitality_promo_consulta")
}

// Línea de desglose de una reserva: alojamiento, limpieza, extra, descuento
// (en negativo) u otro. El ingreso bruto es la suma de las líneas activas.
// El ingreso bruto es la suma de las líneas activas de la reserva.
model HospitalityReservationItem {
  id              String   @id @default(cuid())
  tenantId        String
  reservationId   String
  propertyId      String
  unitId          String?
  tipo            String   @default("alojamiento") // alojamiento|limpieza|extra|otro|penalizacion
  concepto        String
  cantidad        Float    @default(1)
  importeUnitario Float
  importeTotal    Float
  moneda          String   @default("MXN")
  // Factura del ERP emitida por esta línea. Solo la usa la penalización por
  // no-show: es la traza del cargo (regla 5) y la garantía de no facturar dos
  // veces la misma línea. Ver lib/hospitality/penalizaciones.ts.
  invoiceId       String?
  fechaCreacion   DateTime @default(now())
  fechaEdicion    DateTime @updatedAt
  tenant          Tenant                 @relation("HospitalityReservationItems", fields: [tenantId], references: [id], onDelete: Cascade)
  reservation     HospitalityReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  property        HospitalityProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit            HospitalityUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([reservationId])
  @@index([propertyId])
  @@index([tipo])
  @@index([invoiceId])
  @@map("hospitality_reservation_items")
}

// Pago (o intento de pago) de una reserva. Los pagos parciales son filas
// independientes: el estado de cobro se deriva de la suma, nunca se adivina.
model HospitalityPayment {
  id                    String    @id @default(cuid())
  tenantId              String
  reservationId         String
  propertyId            String
  unitId                String?
  importe               Float
  moneda                String    @default("MXN")
  metodo                String    @default("manual") // stripe|transferencia|efectivo|manual|otro
  estado                String    @default("pagado") // pendiente|pagado|parcial|reembolsado|fallido
  referenciaExterna     String?
  stripePaymentIntentId String?
  fechaPago             DateTime?
  notas                 String?
  fechaCreacion         DateTime  @default(now())
  fechaEdicion          DateTime  @updatedAt
  tenant                Tenant                 @relation("HospitalityPayments", fields: [tenantId], references: [id], onDelete: Cascade)
  reservation           HospitalityReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  property              HospitalityProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit                  HospitalityUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([reservationId])
  @@index([propertyId])
  @@index([estado])
  @@map("hospitality_payments")
}

// Cuenta de cobro del tenant (Stripe Connect). El dinero de una reserva directa
// pertenece al tenant, no a Volkern: nunca se cobra contra una cuenta única.
model HospitalityPaymentAccount {
  id              String   @id @default(cuid())
  tenantId        String
  provider        String   @default("stripe")
  stripeAccountId String?
  estado          String   @default("sin_conectar") // sin_conectar|pendiente|activo|restringido
  chargesEnabled  Boolean  @default(false)
  payoutsEnabled  Boolean  @default(false)
  moneda          String   @default("MXN")
  pais            String?
  fechaCreacion   DateTime @default(now())
  fechaEdicion    DateTime @updatedAt
  tenant          Tenant   @relation("HospitalityPaymentAccounts", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("hospitality_payment_accounts")
}

// Plantilla de comunicación automática para Hospitality (plan maestro §21).
// Un tenant define una plantilla por evento y canal; al dispararse el evento,
// se reemplazan las variables con los datos de la reserva/huésped y se envía
// por la integración existente (WhatsApp Evolution o email SMTP/Resend).
model HospitalityCommunicationTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  evento        String   // confirmacion|pre_llegada|check_in|post_salida|resena
  canal         String   @default("whatsapp") // whatsapp|email
  asunto        String?  // Solo para email
  contenido     String   // Texto con variables {{nombre}}, {{checkIn}}, ...
  activo        Boolean  @default(true)
  // Idioma de la plantilla: "es" (defecto) o "en". La comunicación al huésped
  // sale en el idioma en que reservó (guestData.idioma); "es" siempre responde
  // (incluidas OTA y reservas manuales sin idioma) — ver booking-i18n.ts.
  idioma        String   @default("es")
  // Diseño visual del correo (editor de bloques): cabecera, secciones de
  // etiqueta/valor, párrafos y botones. Solo aplica al canal email; WhatsApp
  // sigue enviando `contenido`. Ver lib/hospitality/comunicaciones-email.ts.
  diseno        Json?
  fechaCreacion DateTime @default(now())
  fechaEdicion  DateTime @updatedAt
  tenant        Tenant   @relation("HospitalityCommunicationTemplates", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([evento])
  @@index([canal])
  @@index([activo])
  @@map("hospitality_communication_templates")
}

// Credenciales y datos del sujeto obligado ante el Sistema de Hospedajes del
// Ministerio del Interior (RD 933/2021). Una configuración por tenant (el
// arrendador es el titular de la actividad de hospedaje). El usuario y la
// contraseña los entrega la Sede Electrónica en el momento del registro y
// viajan en la cabecera HTTP Basic de cada petición: se guardan cifrados, como
// el resto de credenciales de integración.
model HospitalityMirConfig {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  // Código de arrendador asignado por el Sistema de Hospedajes. String(10).
  codigoArrendador String
  // Nombre del sistema origen que viaja en la cabecera. String(50).
  aplicacion       String    @default("Volkern")
  // Entorno del servicio: pre (pruebas del Ministerio) | prod.
  entorno          String    @default("pre")
  usuarioEnc       String?
  passwordEnc      String?
  // Códigos del catálogo TIPO_PAGO del Ministerio. No se inventan: los
  // publica el servicio (operación `catalogo`) y el hotel los configura aquí.
  // `mapaTiposPago` traduce el método interno de pago (efectivo, stripe…) al
  // código del catálogo; `tipoPagoDefecto` cubre lo que no esté en el mapa.
  // Sin ninguno de los dos no se envía el parte: mejor `datos_incompletos`
  // que mandar un código de pago inventado.
  tipoPagoDefecto  String?
  mapaTiposPago    Json?
  activo           Boolean   @default(true)
  ultimoEnvio      DateTime?
  ultimoError      String?
  fechaCreacion    DateTime  @default(now())
  fechaEdicion     DateTime  @updatedAt
  tenant           Tenant    @relation("HospitalityMirConfigs", fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("hospitality_mir_config")
}

// Preguntas personalizadas del check-in online: cada hotel define qué más
// quiere saber del huésped (hora de llegada, matrícula, mascotas…) y el
// formulario de `/checkin/<token>` las muestra tras las fichas de viajeros.
// Las respuestas viven en la reserva (`respuestasCheckin`) y NUNCA viajan al
// XML del parte: el esquema del Ministerio es cerrado y un elemento extra
// rechazaría la comunicación entera.
// Reseña de huésped de una estancia (hueco nº 1 frente a Lodgify): el cron de
// solicitud (§21) manda el enlace por token al huésped que hizo check-out, este
// valora su estancia y el hotel la MODERA antes de publicarla en la web pública
// del motor de reservas. Una sola reseña por reserva (@@unique) y una sola por
// token: quien tiene el enlace escribe (o corrige) la reseña de esa estancia.
// Reseñas HISTÓRICAS importadas de OTAs: sin reserva en el sistema, nacen
// `publicada` (ya pasaron el filtro real: el canal las mostró) y llevan huella
// sha256 (canal+fecha+nombre+puntuación) para no importarlas dos veces.
model HospitalityReview {
  id             String    @id @default(cuid())
  tenantId       String
  propertyId     String
  reservationId  String?   @unique
  unitId         String?
  // nativa (ciclo §21) | importada (histórico de una OTA)
  origen         String    @default("nativa")
  // Fecha de la ESTANCIA (check-in) para el «mes de septiembre 2026» público:
  // en las nativas vive en la reserva; en las importadas no hay reserva y se
  // guarda aquí (la columna del CSV del canal).
  fechaEstancia  DateTime?
  // Canal de origen de una importada (Booking.com, Airbnb…): la web y Reportes
  // lo enseñan junto al mes — la prueba social honesta dice de dónde viene.
  // Null en las nativas (su canal real es la venta directa del propio motor).
  canal          String?
  // Huella de una reseña importada (null en las nativas): importar el mismo
  // CSV dos veces no duplica reseñas.
  huellaImport   String?   @unique
  // pendiente (recién escrita, aún no visible) | publicada | rechazada
  estado         String    @default("pendiente")
  puntuacion     Int
  comentario     String?
  // Nombre que se enseña en la web (no el email ni el teléfono).
  nombreHuesped  String
  /** Respuesta pública del hotel a la reseña publicada. */
  respuestaHotel String?
  fechaCreacion  DateTime  @default(now())
  fechaEdicion   DateTime  @updatedAt
  tenant         Tenant                     @relation("HospitalityReviews", fields: [tenantId], references: [id], onDelete: Cascade)
  property       HospitalityProperty        @relation("HospitalityReviews", fields: [propertyId], references: [id], onDelete: Cascade)
  reservation    HospitalityReservation?    @relation("HospitalityReviews", fields: [reservationId], references: [id], onDelete: Cascade)
  unit           HospitalityUnit?           @relation("HospitalityReviews", fields: [unitId], references: [id], onDelete: SetNull)

  @@index([tenantId, estado])
  @@index([propertyId, estado])
  // Reportes agrupa y filtra por canal de origen: el índice lo creó la
  // migración `20260922110000_review_canal` y el esquema no lo declaraba.
  @@index([canal])
  @@map("hospitality_review")
}

// Conversación de mensajería con el huésped EN EL CANAL (OTA), tal y como la
// entrega el webhook de mensajes del proveedor. Una fila por hilo: la clave es
// la del proveedor (`channel` + `conversation_id`), porque el hilo es del
// huésped y de la reserva, no de un usuario de Volkern.
//
// La propiedad se resuelve por mapping (`hotel_id` → ConnectivityMapping) y el
// tenant sale de ahí: sin mapping activo la conversación NO se guarda —el
// webhook responde 404 y el proveedor reintenta—, igual que una reserva sin
// mapping. Un mensaje sin propiedad no tiene a quién entregarse.
model HospitalityCanalConversacion {
  id             String    @id @default(cuid())
  tenantId       String
  propertyId     String?
  // Reserva interna del mismo hilo, si el proveedor manda `booking_id` y hay
  // reserva con ese `externalBookingId`. Null = la conversación es anterior a
  // que la reserva exista aquí (una consulta que aún no es reserva).
  reservationId  String?
  // Canal de la OTA en minúsculas (`booking.com`, `expedia`…).
  canal          String
  // `hotel_id`: cómo identifica el proveedor esta propiedad en el canal.
  hotelCode      String
  // `conversation_id` del proveedor: la clave del hilo en sus APIs.
  conversacionId String
  bookingExterno String?
  huespedNombre  String?
  huespedEmail   String?
  huespedTelefono String?
  ultimoMensajeEn DateTime
  // Entrantes sin leer. El panel los cuenta; abrir un hilo no los marca leídos
  // (eso es una acción explícita del operador, como el resto del módulo).
  sinLeer        Int       @default(0)
  fechaCreacion  DateTime  @default(now())
  fechaEdicion   DateTime  @updatedAt
  tenant         Tenant                  @relation("HospitalityCanalConversaciones", fields: [tenantId], references: [id], onDelete: Cascade)
  property       HospitalityProperty?    @relation("HospitalityCanalConversacionesProperty", fields: [propertyId], references: [id], onDelete: SetNull)
  reservation    HospitalityReservation? @relation("HospitalityCanalConversacionesReservation", fields: [reservationId], references: [id], onDelete: SetNull)
  mensajes       HospitalityCanalMensaje[] @relation("HospitalityCanalMensajesConversacion")

  // Un hilo por canal y conversación dentro del tenant: la entrega repetida del
  // mismo mensaje no abre una segunda conversación.
  @@unique([tenantId, canal, conversacionId])
  // La bandeja ordena por el último mensaje.
  @@index([tenantId, ultimoMensajeEn])
  @@index([propertyId])
  @@map("hospitality_canal_conversacion")
}

// Un mensaje del hilo, en cualquiera de las dos direcciones. Lo que el huésped
// escribió no se edita ni se borra: se guarda tal cual llegó (y si un día se
// corrige algo, será otra fila con su motivo). Una respuesta que no llegó al
// canal se queda aquí como `error` con el texto del proveedor: el hotel tiene
// que ver que NO salió, no un hilo que parece contestado.
model HospitalityCanalMensaje {
  id               String    @id @default(cuid())
  tenantId         String
  conversacionId   String
  // `message_id` del proveedor: dedupe de entregas repetidas. Null en los
  // nuestros (al enviar, el proveedor no nos devuelve uno).
  mensajeExternoId String?
  // entrante (lo escribió el huésped) | saliente (lo escribió el hotel)
  direccion        String
  // `sender_type` del proveedor, o `hotel` en los que escribimos nosotros.
  emisor           String
  contenido        String
  tipo             String    @default("text")
  // `time_sent` del proveedor. Null si vino ilegible: el hilo se ordena por
  // `fechaCreacion` y nunca inventa la hora del huésped.
  enviadoEn        DateTime?
  adjuntos         Json?
  // recibido | enviado | error
  estado           String    @default("recibido")
  error            String?
  fechaCreacion    DateTime  @default(now())
  fechaEdicion     DateTime  @updatedAt
  tenant           Tenant                       @relation("HospitalityCanalMensajes", fields: [tenantId], references: [id], onDelete: Cascade)
  conversacion     HospitalityCanalConversacion  @relation("HospitalityCanalMensajesConversacion", fields: [conversacionId], references: [id], onDelete: Cascade)

  // Dedupe por mensaje del proveedor dentro del hilo.
  @@unique([conversacionId, mensajeExternoId])
  @@index([tenantId, fechaCreacion])
  @@index([conversacionId, fechaCreacion])
  @@map("hospitality_canal_mensaje")
}

model HospitalityCheckinPregunta {
  id        String   @id @default(cuid())
  tenantId  String
  // Pregunta y opciones (si tipo = opcion) en ES y EN — el formulario es
  // bilingüe y una pregunta solo en un idioma rompería la pantalla.
  es        Json
  en        Json
  // texto | opcion | numero | fecha
  tipo      String   @default("texto")
  opciones  Json?
  requerida Boolean  @default(false)
  activa    Boolean  @default(true)
  orden     Int      @default(0)
  fechaCreacion DateTime @default(now())
  fechaEdicion  DateTime @updatedAt
  tenant    Tenant   @relation("HospitalityCheckinPreguntas", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, activa])
  @@map("hospitality_checkin_pregunta")
}

// Traza de cada comunicación enviada al Ministerio (una fila por parte de
// viajeros y reserva). El alta es ASÍNCRONA: el `0` solo confirma que la
// petición se recibió y devuelve un número de lote; el código de comunicación
// (o el error de validación) se obtiene después consultando el lote. La fila
// guarda ambos momentos para poder auditar qué se envió, cuándo y con qué
// resultado — obligación documental del propio RD 933/2021.
model HospitalityGuestRegistryCommunication {
  id                    String    @id @default(cuid())
  tenantId              String
  reservationId         String?
  tipoComunicacion      String    @default("PV")
  // A = alta, B = anulación (RD: anular la comunicación si se cancela).
  tipoOperacion         String    @default("A")
  // pendiente | enviada | aceptada | rechazada | anulada | error | datos_incompletos
  estado                String    @default("pendiente")
  referencia            String?
  codigoEstablecimiento String?
  lote                  String?
  codigoComunicacion    String?
  codigoRetorno         String?
  descripcion           String?
  intentos              Int       @default(0)
  errores               Json?
  xmlSolicitud          String?
  respuesta             String?
  fechaEnvio            DateTime?
  fechaRespuesta        DateTime?
  fechaCreacion         DateTime  @default(now())
  fechaEdicion          DateTime  @updatedAt
  tenant                Tenant    @relation("HospitalityGuestRegistry", fields: [tenantId], references: [id], onDelete: Cascade)
  reservation           HospitalityReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  // Una comunicación de cada tipo por reserva y operación: el barrido es
  // idempotente y no reenvía lo ya aceptado.
  @@unique([tenantId, reservationId, tipoComunicacion, tipoOperacion])
  @@index([tenantId])
  @@index([estado])
  @@index([lote])
  @@index([reservationId])
  @@map("hospitality_guest_registry_communications")
}

// Instantánea del health score de un deal (C6) en un momento dado, con SUS
// ENTRADAS (estancamiento, actividad, SLA) y el DESENLACE del deal (ganado /
// perdido / abierto). Es el dataset de calibración: permite comprobar si el
// score ordena bien y ajustar pesos y cortes con datos reales en vez de con
// hipótesis. Nace con la etiqueta de desenlace NULL y el PATCH del deal la
// rellena al cerrar — los snapshots anteriores a un cierre nunca se recrean.
model HospitalityBookingConfig {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  // Segmento público de la URL (/reservar/<slug>): identifica al tenant ante
  // cualquiera. Único en toda la plataforma, no solo dentro del tenant.
  slug                  String   @unique
  titulo                String?
  descripcion           String?
  emailContacto         String?
  telefonoContacto      String?
  // Divisa con la que se publican los precios. Nulo = la del tenant
  // (`Tenant.moneda`), que es la fuente autoritativa: el valor por defecto del
  // esquema nunca decide aquí (regla del módulo único de dinero).
  moneda                String?
  politicaCancelacion   String?
  // Anticipo a cobrar en el momento de reservar, en porcentaje del total.
  // 0 = sin anticipo.
  anticipoPorcentaje    Int      @default(0)
  // Tarifa de limpieza por estancia del canal directo. Nula = no se cobra:
  // null es "no aplica", no un cero que parecería una decisión de negocio.
  tarifaLimpieza        Float?
  // Si se exige cobro online para confirmar. En falso, la reserva entra como
  // pendiente y el alojamiento cobra por su cuenta.
  requierePagoOnline    Boolean  @default(false)
  // Propiedades publicadas en la página pública. Vacío = no hay nada publicado.
  propiedadesPublicadas String[] @default([])
  // Unidades que, aun estando en una propiedad publicada, NO salen en la página
  // pública (solo se venden por canal, uso interno, obras...). Vacío = salen
  // todas. Solo afecta al motor directo: no toca disponibilidad ni canales.
  unidadesExcluidas     String[] @default([])
  activo                Boolean  @default(true)
  // Plantilla visual de la página pública. Valor del módulo puro
  // (`PLANTILLA_CLASICA`…); null = la clásica. Un valor desconocido se trata
  // como clásica en el servidor, nunca rompe la página.
  plantilla             String?
  // Personalización visual libre (colores, radios) en JSON. El módulo puro
  // valida y completa defaults: lo que llegue malformado no rompe la página.
  personalizacion       Json?
  // Dominio propio del tenant para su página de reserva (ej: reservas.mihotel.com).
  // Normalizado minúscula/sin www por el módulo; único en toda la plataforma.
  // La verificación DNS se guarda aparte y se re-checa desde el panel.
  dominio               String?  @unique
  dominioVerificado     Boolean  @default(false)
  fechaCreacion         DateTime @default(now())
  fechaEdicion          DateTime @updatedAt
  tenant                Tenant   @relation("HospitalityBookingConfig", fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("hospitality_booking_config")
}

model HospitalityCompliance {
  id                 String    @id @default(cuid())
  tenantId           String
  reservationId      String    @unique
  estadoReserva      String    @default("pendiente") // Comunicación RH
  estadoViajeros     String    @default("pendiente") // Comunicación PV
  codigoComunicacion String?
  loteId             String?
  enviadoEn          DateTime?
  procesadoEn          DateTime?
  codigoError        String?
  mensajeError       String?
  fechaCreacion      DateTime  @default(now())
  fechaEdicion       DateTime  @updatedAt
  tenant             Tenant    @relation("HospitalityCompliances", fields: [tenantId], references: [id], onDelete: Cascade)
  reservation        HospitalityReservation @relation("HospitalityReservationCompliance", fields: [reservationId], references: [id], onDelete: Cascade)
  eventos            HospitalityComplianceEvent[]

  @@index([tenantId])
  @@index([estadoReserva])
  @@index([estadoViajeros])
  @@map("hospitality_compliance")
}

model HospitalityComplianceConfig {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  activo         Boolean   @default(false)
  entorno        String    @default("pruebas") // pruebas|produccion
  entidadNombre  String?
  entidadNif     String?
  usuarioEnc     String?
  passwordEnc    String?
  /**
   * Certificado digital de la entidad (el .p12/.pfx de la FNMT) en Base64 y su
   * contraseña, ambos cifrados en reposo. El certificado viaja presentado en el TLS
   * de cada comunicación: es lo que le dice al Ministerio quién comunica.
   */
  certificadoEnc         String? @db.Text
  certificadoPasswordEnc String?
  /**
   * Lo que el certificado dice de sí mismo, para que el administrador vea qué
   * instaló sin volver a subirlo. Son datos públicos del certificado (no secretos).
   */
  certificadoTitular String?
  certificadoNif     String?
  certificadoEmisor  String?
  certificadoHuella  String?
  certificadoVence   DateTime?
  /**
   * Código de arrendador de la entidad: lo asigna el Ministerio en el registro
   * (cabecera del lote SOAP, obligatoria para comunicar).
   */
  codigoArrendador String?
  estadoConexion   String    @default("sin_configurar")
  ultimoEnvio      DateTime?
  ultimoCodigo     String?
  ultimoError      String?
  fechaCreacion    DateTime  @default(now())
  fechaEdicion     DateTime  @updatedAt
  tenant           Tenant    @relation("HospitalityComplianceConfigs", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([estadoConexion])
  @@map("hospitality_compliance_config")
}

model HospitalityComplianceEvent {
  id                 String   @id @default(cuid())
  tenantId           String
  reservationId      String
  complianceId       String?
  tipo               String // reserva|viajeros|anulacion|acceso
  estado             String // enviado|procesando|ok|error|anulado
  codigoComunicacion String?
  codigoError        String?
  mensajeError       String?
  detalle            String?
  usuarioId          String?
  fechaCreacion      DateTime @default(now())
  tenant             Tenant   @relation("HospitalityComplianceEvents", fields: [tenantId], references: [id], onDelete: Cascade)
  compliance         HospitalityCompliance? @relation(fields: [complianceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reservationId])
  @@index([complianceId])
  @@index([tipo])
  @@map("hospitality_compliance_events")
}

model HospitalityTraveler {
  id               String    @id @default(cuid())
  tenantId         String
  reservationId    String
  esTitular        Boolean   @default(false)
  orden            Int       @default(0)
  nombre           String
  apellido1        String
  apellido2        String?
  tipoDocumento    String?
  numeroDocumento  String?
  soporteDocumento String?
  fechaNacimiento  DateTime?
  nacionalidad     String?
  /**
   * Domicilio del viajero: el parte de viajeros (PV) lo exige por persona
   * (vía, municipio y código postal, país ISO alfa-3 según el XSD).
   */
  direccion        String?
  municipio        String?
  codigoMunicipio  String?
  codigoPostal     String?
  paisDireccion    String?
  estado           String    @default("pendiente")
  // Seguimiento del enlace de WhatsApp (pedir/reenviar datos al viajero).
  enlaceEnviadoEn  DateTime?
  enlaceEnviados   Int       @default(0)
  datosRecibidosEn DateTime?
  fechaCreacion    DateTime  @default(now())
  fechaEdicion     DateTime @updatedAt
  tenant           Tenant    @relation("HospitalityTravelers", fields: [tenantId], references: [id], onDelete: Cascade)
  reservation      HospitalityReservation @relation("HospitalityReservationTravelers", fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reservationId])
  @@index([estado])
  @@map("hospitality_travelers")
}

model HealthSnapshot {
  id           String    @id @default(cuid())
  tenantId     String
  dealId       String
  healthScore  Int
  healthStatus String
  diasSinMovimiento Int
  diasSinActividad  Int
  slaVencido   Boolean
  desenlace    String? // null = abierto · 'ganado' | 'perdido'
  fechaCierre  DateTime?
  createdAt    DateTime  @default(now())
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@index([desenlace])
  @@map("health_snapshots")
}

