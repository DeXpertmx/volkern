{
  "expo": {
    "name": "Volkern CRM",
    "slug": "volkern",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "volkern",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.volkern.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usa Face ID o Touch ID para acceder rápidamente a Volkern",
        "NSCameraUsageDescription": "Gemma usa la cámara para escanear códigos QR y de barras",
        "NSMicrophoneUsageDescription": "Gemma usa el micrófono para comandos de voz",
        "NSLocationWhenInUseUsageDescription": "Gemma usa tu ubicación para contexto industrial"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.volkern.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gemma necesita acceder a tus fotos para adjuntarlas al chat"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83dbadab-e05d-4e60-8993-16aeb4b2603c"
      }
    },
    "owner": "dimension-expert"
  }
}
