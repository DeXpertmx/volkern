# ─── Volkern App — Variables de Entorno ────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores según tu entorno.

# URL base de la API (Next.js + API routes)
# En producción: https://volkern.app
# En desarrollo local: http://localhost:3000
EXPO_PUBLIC_API_URL=https://volkern.app

# URL base de la web (para links que abren el navegador)
# En producción: https://volkern.app
# En desarrollo local: http://localhost:3000
EXPO_PUBLIC_WEB_URL=https://volkern.app
