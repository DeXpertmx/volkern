mmary Label","classes":["summary-label"],"components":[{"type":"textnode","content":"Base"}]},{"tagName":"p","type":"text","name":"Summary Value","classes":["summary-value"],"attributes":{"id":"summary-base"},"components":[{"type":"textnode","content":"€50"}]}]},{"name":"Summary Item","classes":["summary-item"],"components":[{"tagName":"p","type":"text","name":"Summary Label","classes":["summary-label"],"components":[{"type":"textnode","content":"Usuarios"}]},{"tagName":"p","type":"text","name":"Summary Value","classes":["summary-value"],"attributes":{"id":"summary-users"},"components":[{"type":"textnode","content":"€0"}]}]},{"name":"Summary Item","classes":["summary-item"],"components":[{"tagName":"p","type":"text","name":"Summary Label","classes":["summary-label"],"components":[{"type":"textnode","content":"Contactos"}]},{"tagName":"p","type":"text","name":"Summary Value","classes":["summary-value"],"attributes":{"id":"summary-contacts"},"components":[{"type":"textnode","content":"€0"}]}]}]}]}]},{"name":"Pricing Controls Side","classes":["pricing-controls-side"],"components":[{"name":"Selectors Grid","classes":["selectors-grid"],"components":[{"type":"label","name":"Selector Field","classes":["selector-field"],"components":[{"tagName":"span","type":"text","name":"Field Label","classes":["field-label"],"components":[{"type":"textnode","content":"Moneda"}]},{"type":"select","name":"Currency Select","classes":["field-select","currency-select"],"attributes":{"type":"text","id":"currency-select"},"components":[{"type":"option","attributes":{"value":"EUR"},"components":[{"type":"textnode","content":"EUR"}]},{"type":"option","attributes":{"value":"USD"},"components":[{"type":"textnode","content":"USD"}]}]}]},{"type":"label","name":"Selector Field","classes":["selector-field"],"components":[{"tagName":"span","type":"text","name":"Field Label","classes":["field-label"],"components":[{"type":"textnode","content":"Facturación"}]},{"type":"select","name":"Billing Select","classes":["field-select","billing-select"],"attributes":{"type":"text","id":"billing-select"},"components":[{"type":"option","attributes":{"value":"monthly"},"components":[{"type":"textnode","content":"Mensual"}]},{"type":"option","attributes":{"value":"annual"},"components":[{"type":"textnode","content":"Anual -40%"}]}]}]}]},{"name":"Slider Field","classes":["ring-soft","slider-field"],"components":[{"name":"Slider Header","classes":["slider-header"],"components":[{"name":"Slider Title Group","classes":["slider-title-group"],"components":[{"tagName":"span","type":"text","name":"Slider Label","classes":["slider-label"],"components":[{"type":"textnode","content":"Usuarios"}]},{"tagName":"span","type":"text","name":"Slider Help","classes":["slider-help"],"components":[{"type":"textnode","content":"Base incluye 1 usuario. Cada usuario adicional suma 20."}]}]},{"tagName":"span","type":"text","name":"Slider Value Badge","classes":["slider-value-badge"],"attributes":{"id":"users-value"},"components":[{"type":"textnode","content":"1 usuario"}]}]},{"type":"input","name":"Users Range","void":true,"classes":["pricing-range","users-range"],"attributes":{"type":"range","id":"users-range","min":"1","max":"99","step":"1","value":"1"}},{"name":"Slider Ends","classes":["slider-ends"],"components":[{"tagName":"span","type":"text","name":"Slider Min","components":[{"type":"textnode","content":"1"}]},{"tagName":"span","type":"text","name":"Slider Max","components":[{"type":"textnode","content":"99"}]}]}]},{"name":"Slider Field","classes":["ring-soft","slider-field"],"components":[{"name":"Slider Header","classes":["slider-header"],"components":[{"name":"Slider Title Group","classes":["slider-title-group"],"components":[{"tagName":"span","type":"text","name":"Slider Label","classes":["slider-label"],"components":[{"type":"textnode","content":"Contactos"}]},{"tagName":"span","type":"text","name":"Slider Help","classes":["slider-help"],"components":[{"type":"textnode","content":"Base incluye 1.000 contactos. Cada 1.000 adicionales suma 5."}]}]},{"tagName":"span","type":"text","name":"Slider Value Badge","classes":["slider-value-badge"],"attributes":{"id":"contacts-value"},"components":[{"type":"textnode","content":"1.000 contactos"}]}]},{"type":"input","name":"Contacts Range","void":true,"classes":["pricing-range","contacts-range"],"attributes":{"type":"range","id":"contacts-range","min":"1000","max":"99000","step":"1000","value":"1000"}},{"name":"Slider Ends","classes":["slider-ends"],"components":[{"tagName":"span","type":"text","name":"Slider Min","components":[{"type":"textnode","content":"1.000"}]},{"tagName":"span","type":"text","name":"Slider Max","components":[{"type":"textnode","content":"99.000"}]}]}]},{"name":"Pricing Assurance","classes":["bg-cyan-300/8","pricing-assurance"],"components":[{"tagName":"p","type":"text","name":"Assurance Text","classes":["assurance-text"],"components":[{"type":"textnode","content":"Volkern no es una herramienta más. Es la capa operativa que unifica ventas, marketing, comunicación, automatización e IA para que pagar "},{"tagName":"span","type":"text","classes":["cls-ue8znp"],"attributes":{"id":"assurance-price"},"components":[{"type":"textnode","content":"€50"}]},{"type":"textnode","content":" se sienta ridículamente rentable."}]}]}]}]}]}]},{"tagName":"section","name":"Differential Section","classes":["differential-section"],"components":[{"tagName":"p","type":"text","name":"Differential Eyebrow","classes":["differential-eyebrow"],"components":[{"type":"textnode","content":"La diferencia Volkern"}]},{"tagName":"h2","type":"heading","name":"Differential Title","classes":["gjs-t-h2","differential-title"],"components":[{"type":"textnode","content":"No estás comprando herramientas."},{"tagName":"br","name":"Line Break","void":true},{"type":"textnode","content":"Estás activando un sistema completo."}]},{"tagName":"p","type":"text","name":"Differential Subtitle","classes":["differential-subtitle"],"components":[{"type":"textnode","content":"CRM + Marketing + Comunicación + Operación + IA. Todo conectado."}]}]},{"tagName":"section","name":"Final CTA Section","classes":["final-cta-section"],"components":[{"name":"Final CTA Card","classes":["ring-soft","final-cta-card"],"components":[{"name":"Final CTA Content","classes":["final-cta-content"],"components":[{"tagName":"p","type":"text","name":"Final CTA Eyebrow","classes":["final-cta-eyebrow"],"components":[{"type":"textnode","content":"Cambio de categoría"}]},{"tagName":"h2","type":"heading","name":"Final CTA Title","classes":["gjs-t-h2","final-cta-title"],"components":[{"type":"textnode","content":"Menos herramientas. Más control."}]},{"tagName":"p","type":"text","name":"Final CTA Subtitle","classes":["final-cta-subtitle"],"components":[{"type":"textnode","content":"Reduce complejidad, baja costos y opera con una única plataforma pensada para crecer contigo."}]},{"type":"link","name":"Final CTA Button","classes":["gjs-t-button","hero-button","final-cta-button"],"attributes":{"href":"#pricing"},"components":[{"type":"textnode","content":"Activar Volkern"}]}]}]}]}]}]},{"type":"script","components":[{"type":"textnode","content":"\n    (function() {\n      var basePrice = 50;\n      var userIncrement = 20;\n      var contactIncrement = 5;\n      var annualDiscount = 0.4;\n\n      var currencySelect = document.getElementById('currency-select');\n      var billingSelect = document.getElementById('billing-select');\n      var usersRange = document.getElementById('users-range');\n      var contactsRange = document.getElementById('contacts-range');\n\n      var priceValue = document.getElementById('price-value');\n      var priceSuffix = document.getElementById('price-suffix');\n      var billingBadge = document.getElementById('billing-badge');\n      var usersValue = document.getElementById('users-value');\n      var contactsValue = document.getElementById('contacts-value');\n      var summaryBase = document.getElementById('summary-base');\n      var summaryUsers = document.getElementById('summary-users');\n      var summaryContacts = document.getElementById('summary-contacts');\n      var replacementText = document.getElementById('replacement-text');\n      var assurancePrice = document.getElementById('assurance-price');\n\n      function formatNumber(value) {\n        return new Intl.NumberFormat('es-ES').format(value);\n      }\n\n      function getSymbol(currency) {\n        return currency === 'USD' ? '$' : '€';\n      }\n\n      function updatePricing() {\n        var currency = currencySelect.value;\n        var billing = billingSelect.value;\n        var users = parseInt(usersRange.value, 10);\n        var contacts = parseInt(contactsRange.value, 10);\n\n        var additionalUsers = Math.max(0, users - 1);\n        var additionalContacts = Math.max(0, (contacts - 1000) / 1000);\n\n        var userCost = additionalUsers * userIncrement;\n        var contactCost = additionalContacts * contactIncrement;\n        var subtotal = basePrice + userCost + contactCost;\n        var total = billing === 'annual' ? subtotal * (1 - annualDiscount) : subtotal;\n        var roundedTotal = Math.round(total);\n\n        var symbol = getSymbol(currency);\n        var replacementBase = currency === 'USD' ? 180 : 180;\n\n        priceValue.textContent = symbol + roundedTotal;\n        priceSuffix.textContent = billing === 'annual' ? '/mes facturado anual' : '/mes';\n        billingBadge.textContent = billing === 'annual' ? 'Anual -40%' : 'Mensual';\n\n        usersValue.textContent = users + (users === 1 ? ' usuario' : ' usuarios');\n        contactsValue.textContent = formatNumber(contacts) + ' contactos';\n\n        summaryBase.textContent = symbol + basePrice;\n        summaryUsers.textContent = symbol + userCost;\n        summaryContacts.textContent = symbol + contactCost;\n\n        replacementText.textContent = symbol + replacementBase + '/mes';\n        assurancePrice.textContent = symbol + roundedTotal;\n      }\n\n      currencySelect.addEventListener('change', updatePricing);\n      billingSelect.addEventListener('change', updatePricing);\n      usersRange.addEventListener('input', updatePricing);\n      contactsRange.addEventListener('input', updatePricing);\n\n      updatePricing();\n    })();\n  "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"meta","void":true,"attributes":{"charset":"utf-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1"}},{"tagName":"title","type":"text","components":[{"type":"textnode","content":"Volkern | El sistema operativo de tu negocio"}]},{"tagName":"meta","void":true,"attributes":{"name":"description","content":"Volkern reúne CRM, marketing, comunicación, automatización e IA en una sola plataforma para operar tu negocio con menos herramientas y más control."}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.googleapis.com"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":"anonymous"}},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","attributes":{"lang":"es"}}},"id":"Lsp1y7iZFjcviDWD","minHeight":"500px"}],"id":"64H33zi9WPiKZ0xCi"}],"symbols":[],"custom":{"projectType":"web","id":"landingProject"}}