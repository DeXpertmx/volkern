#   - scripts/add-dexpert-client-admin.ts (DEXPERT_ADMIN_TEMP_PASSWORD)
#   - scripts/seed-demo-real-estate.ts    (DEMO_RE_PASSWORD)
#   - scripts/verify-auth-bootstrap.ts    (ADMIN_TEMP_PASSWORD, DEXPERT_ADMIN_TEMP_PASSWORD)
#   - scripts/try-admin-passwords.ts      (ADMIN_CANDIDATES, opcional; o candidatos por argumento)

