# las variables en el shell antes de ejecutar los scripts de bootstrap/reset.
#
#   cp scripts/bootstrap-admin.env.example scripts/.env.local
#   # edita scripts/.env.local con las contraseñas reales (nunca commitees ese archivo)
#   npx tsx --require dotenv/config scripts/bootstrap-admin.ts
#
# Variables usadas por:
#   - scripts/bootstrap-admin.ts          (ADMIN_TEMP_PASSWORD, DEXPERT_ADMIN_TEMP_PASSWORD)
