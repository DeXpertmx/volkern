        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="&lt;b&gt;Arquitectura del Sistema de Agencia — Volkern&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot; color=&quot;#6b7280&quot;&gt;Provisioning de Slots, Activación de Módulos y Marca Blanca&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="50" as="geometry"/>
        </mxCell>

        <!-- ===================== SECTION 1: TENANT TYPES ===================== -->
        <mxCell id="section1-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#d1d5db;dashed=1;verticalAlign=top;fontSize=11;fontColor=#6b7280;" parent="1" vertex="1">
          <mxGeometry x="40" y="90" width="1120" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="section1-label" value="&lt;b&gt;📍 1. Tipos de Tenant&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontColor=#374151;" parent="1" vertex="1">
          <mxGeometry x="50" y="100" width="200" height="30" as="geometry"/>
        </mxCell>

        <!-- AGENCY Tenant -->
        <mxCell id="agency-box" value="&lt;b&gt;🏢 Tenants AGENCY&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;• accountType: &lt;b&gt;'AGENCY'&lt;/b&gt;&lt;br&gt;• plan: 'pro-agency' | 'growth'&lt;br&gt;• parentId: &lt;i&gt;null&lt;/i&gt;&lt;br&gt;• maxSlots: &lt;i&gt;N (límite de slots)&lt;/i&gt;&lt;br&gt;• brandingConfig: &lt;i&gt;JSON (logo, colores)&lt;/i&gt;&lt;br&gt;• enabledModules: ['crm', 'ia_agencia']&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;arcSize=8;fontSize=12;fontColor=#312e81;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="280" height="140" as="geometry"/>
        </mxCell>

        <!-- Arrow AGENCY → Slots -->
        <mxCell id="arrow-agency-slots" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6366f1;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;" parent="1" source="agency-box" target="slot-list-box" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Slot List -->
        <mxCell id="slot-list-box" value="&lt;b&gt;📋 Slots (Sub-tenants BUSINESS)&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;• accountType: &lt;b&gt;'BUSINESS'&lt;/b&gt;&lt;br&gt;• plan: 'agency-slot'&lt;br&gt;• parentId: &lt;i&gt;ref → Tenant AGENCY&lt;/i&gt;&lt;br&gt;• enabledModules: ['CRM', 'MARKETING', ...]&lt;br&gt;• brandingConfig: &lt;i&gt;heredado de AGENCY&lt;/i&gt;&lt;br&gt;• billingEmail: &lt;i&gt;admin@cliente.com&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;arcSize=8;fontSize=12;fontColor=#166534;" parent="1" vertex="1">
          <mxGeometry x="470" y="140" width="300" height="140" as="geometry"/>
        </mxCell>

        <!-- BUSINESS Tenant (standalone) -->
        <mxCell id="business-box" value="&lt;b&gt;🏢 Tenants BUSINESS (Directos)&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;• accountType: &lt;b&gt;'BUSINESS'&lt;/b&gt;&lt;br&gt;• plan: 'starter' | 'growth' | 'pro'&lt;br&gt;• parentId: &lt;i&gt;null&lt;/i&gt;&lt;br&gt;• enabledModules: según plan&lt;br&gt;• brandingConfig: su propia config&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;arcSize=8;fontSize=12;fontColor=#991b1b;" parent="1" vertex="1">
          <mxGeometry x="870" y="140" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- ===================== SECTION 2: PROVISIONING FLOW ===================== -->
        <mxCell id="section2-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;verticalAlign=top;fontSize=11;fontColor=#6b7280;" parent="1" vertex="1">
          <mxGeometry x="40" y="370" width="1120" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="section2-label" value="&lt;b&gt;⚙️ 2. Flujo de Provisioning de Slots&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontColor=#374151;" parent="1" vertex="1">
          <mxGeometry x="50" y="380" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 1: UI Modal -->
        <mxCell id="step1" value="&lt;b&gt;1. UI: SlotProvisioningModal&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Usuario AGENCY llena formulario:&lt;br&gt;• client_name (requerido)&lt;br&gt;• admin_email (requerido, email válido)&lt;br&gt;• modules_enabled (checkboxes: CRM ✅, Marketing ☐)&lt;br&gt;&lt;br&gt;→ POST /api/agency/slots&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;arcSize=8;fontSize=10;fontColor=#1e293b;" parent="1" vertex="1">
          <mxGeometry x="65" y="420" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- Arrow Step1 → Step2 -->
        <mxCell id="arrow12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2;endArrow=blockThin;endFill=1;" parent="1" source="step1" target="step2" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 2: Auth -->
        <mxCell id="step2" value="&lt;b&gt;2. Autenticación&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;withTenantAuth() verifica:&lt;br&gt;• API Key o JWT válido&lt;br&gt;• accountType === 'AGENCY'&lt;br&gt;• O usuario 'Superadmin'&lt;br&gt;&lt;br&gt;❌ 403 si no es AGENCY&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;arcSize=8;fontSize=10;fontColor=#1e293b;" parent="1" vertex="1">
          <mxGeometry x="350" y="420" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- Arrow Step2 → Step3 -->
        <mxCell id="arrow23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2;endArrow=blockThin;endFill=1;" parent="1" source="step2" target="step3" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 3: Zod Validation -->
        <mxCell id="step3" value="&lt;b&gt;3. Validación Zod&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;AgencySlotCreateSchema.safeParse():&lt;br&gt;• client_name: &lt;b&gt;z.string().min(1)&lt;/b&gt;&lt;br&gt;• admin_email: &lt;b&gt;z.string().email()&lt;/b&gt;&lt;br&gt;• modules_enabled: &lt;b&gt;z.string().array().optional()&lt;/b&gt;&lt;br&gt;&lt;br&gt;❌ 400 si datos inválidos&lt;br&gt;+ details del error Zod&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;arcSize=8;fontSize=10;fontColor=#1e293b;" parent="1" vertex="1">
          <mxGeometry x="635" y="420" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- Arrow Step3 → Step4 -->
        <mxCell id="arrow34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2;endArrow=blockThin;endFill=1;" parent="1" source="step3" target="step4" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Step 4: Check Limits -->
        <mxCell id="step4" value="&lt;b&gt;4. Verificar Límites&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;prisma.tenant.count(parentId) &amp;gt;=&lt;br&gt;tenant.maxSlots ?&lt;br&gt;&lt;br&gt;❌ 403 &amp;quot;Límite de slots alcanzado&amp;quot;&lt;br&gt;Si maxSlots=0 → bloqueado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;arcSize=8;fontSize=10;fontColor=#1e293b;" parent="1" vertex="1">
          <mxGeometry x="920" y="420" width="215" height="170" as="geometry"/>
        </mxCell>

        <!-- Create operation box -->
        <mxCell id="create-op" value="&lt;b&gt;5. Creación en BD&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;prisma.tenant.create({&lt;br&gt;&amp;nbsp;&amp;nbsp;nombre: client_name,&lt;br&gt;&amp;nbsp;&amp;nbsp;slug: &lt;i&gt;{nombre}-{random}&lt;/i&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;accountType: &lt;b&gt;'BUSINESS'&lt;/b&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;parentId: &lt;i&gt;auth.tenant.id&lt;/i&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;billingEmail: admin_email,&lt;br&gt;&amp;nbsp;&amp;nbsp;brandingConfig: &lt;i&gt;heredado&lt;/i&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;enabledModules: &lt;i&gt;normalizados uppercase&lt;/i&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;plan: 'agency-slot',&lt;br&gt;&amp;nbsp;&amp;nbsp;estado: 'activo'&lt;br&gt;}) → 201 Created&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;arcSize=8;fontSize=10;fontColor=#166534;" parent="1" vertex="1">
          <mxGeometry x="350" y="630" width="480" height="200" as="geometry"/>
        </mxCell>

        <!-- Arrow Step4 → Create (down) -->
        <mxCell id="arrow4create" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#22c55e;strokeWidth=2;endArrow=blockThin;endFill=1;" parent="1" source="step4" target="create-op" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow Step3 → Create -->
        <mxCell id="arrow3create" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#94a3b8;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;" parent="1" source="step3" target="create-op" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow Step2 → Create -->
        <mxCell id="arrow2create" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#94a3b8;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;" parent="1" source="step2" target="create-op" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow Step1 → Create -->
        <mxCell id="arrow1create" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#94a3b8;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;" parent="1" source="step1" target="create-op" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===================== SECTION 3: MODULE ACTIVATION ===================== -->
        <mxCell id="section3-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;dashed=1;verticalAlign=top;fontSize=11;fontColor=#6b7280;" parent="1" vertex="1">
          <mxGeometry x="40" y="870" width="1120" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="section3-label" value="&lt;b&gt;🔌 3. Activación de Módulos&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontColor=#374151;" parent="1" vertex="1">
          <mxGeometry x="50" y="880" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- Module Sources -->
        <mxCell id="mod-sources" value="&lt;b&gt;📥 Fuentes de Módulos&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;1. Plan Base&lt;/b&gt; (PLAN_MODULES[plan])&lt;br&gt;   Ej: AGENCY_SLOT → leads, contactos, pipeline...&lt;br&gt;&lt;br&gt;&lt;b&gt;2. enabledModules&lt;/b&gt; (manual override)&lt;br&gt;   Seteado en provisioning: ['CRM', 'MARKETING']&lt;br&gt;&lt;br&gt;&lt;b&gt;→ 'agency' module&lt;/b&gt; (PRO_AGENCY)&lt;br&gt;   Desbloquea el hub de agencia en la UI&lt;br&gt;&lt;br&gt;&lt;b&gt;3. TenantFeature&lt;/b&gt; (add-ons / admin toggle)&lt;br&gt;   habilitado=true → agrega módulo&lt;br&gt;   habilitado=false → quita módulo&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Dependencias&lt;/b&gt;&lt;br&gt;   'estrategia' requiere 'proyectos'&lt;br&gt;   'agency' requiere accountType='AGENCY'&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;arcSize=8;fontSize=10;fontColor=#78350f;" parent="1" vertex="1">
          <mxGeometry x="65" y="920" width="310" height="220" as="geometry"/>
        </mxCell>

        <!-- Merge Function -->
        <mxCell id="mod-merge" value="&lt;b&gt;🔄 getActiveModules()&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;// lib/plans.ts&lt;br&gt;getActiveModules(plan, tenantFeatures) {&lt;br&gt;&amp;nbsp;&amp;nbsp;1. Obtener módulos del plan&lt;br&gt;&amp;nbsp;&amp;nbsp;2. Merge con enabledModules&lt;br&gt;&amp;nbsp;&amp;nbsp;3. Aplicar overrides TenantFeature&lt;br&gt;&amp;nbsp;&amp;nbsp;4. Forzar módulos críticos&lt;br&gt;&amp;nbsp;&amp;nbsp;5. Validar dependencias&lt;br&gt;}&lt;br&gt;&lt;br&gt;→ Devuelve array de CrmModule&lt;br&gt;Ej: ['leads','contactos','pipeline','mensajes',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'citas','catalogo','campanas','cms', ...]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;arcSize=8;fontSize=10;fontColor=#78350f;" parent="1" vertex="1">
          <mxGeometry x="430" y="920" width="300" height="230" as="geometry"/>
        </mxCell>

        <!-- Arrow Sources → Merge -->
        <mxCell id="arrow-src-merge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d97706;strokeWidth=2;endArrow=blockThin;endFill=1;" parent="1" source="mod-sources" target="mod-merge" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Module Consumers -->
        <mxCell id="mod-consumers" value="&lt;b&gt;📱 Consumidores de Módulos&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;API Routes&lt;/b&gt; — api-key-auth.ts&lt;br&gt;   if (!enabledModules.includes(module)) → 403&lt;br&gt;&lt;br&gt;&lt;b&gt;Navigation&lt;/b&gt; — navigation-config.ts&lt;br&gt;   HUBS[].requiredModule filtra hubs&lt;br&gt;   Ej: finanzas → requiredModule: 'finanzas'&lt;br&gt;&lt;br&gt;&lt;b&gt;UI Components&lt;/b&gt; — SlotList.tsx&lt;br&gt;   slot.enabledModules.includes('marketing')&lt;br&gt;   → Muestra badge MKT en tabla&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;arcSize=8;fontSize=10;fontColor=#78350f;" parent="1" vertex="1">
          <mxGeometry x="790" y="920" width="340" height="220" as="geometry"/>
        </mxCell>

        <!-- Arrow Merge → Consumers -->
        <mxCell id="arrow-merge-cons" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d97706;strokeWidth=2;endArrow=blockThin;endFill=1;" parent="1" source="mod-merge" target="mod-consumers" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===================== SECTION 4: BRANDING ===================== -->
        <mxCell id="section4-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;dashed=1;verticalAlign=top;fontSize=11;fontColor=#6b7280;" parent="1" vertex="1">
          <mxGeometry x="40" y="1330" width="1120" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="section4-label" value="&lt;b&gt;🎨 4. Marca Blanca (Branding)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontColor=#374151;" parent="1" vertex="1">
          <mxGeometry x="50" y="1340" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- Branding Config -->
        <mxCell id="branding-ui" value="&lt;b&gt;🖌️ Página de Branding&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;/dashboard/agencia/branding&lt;br&gt;&lt;br&gt;Campos configurables:&lt;br&gt;• logo_url (upload imagen)&lt;br&gt;• primary_color (color picker)&lt;br&gt;• show_powered_by (boolean)&lt;br&gt;• custom_footer_text (texto)&lt;br&gt;&lt;br&gt;→ PATCH /api/agency/settings/branding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;arcSize=8;fontSize=10;fontColor=#0c4a6e;" parent="1" vertex="1">
          <mxGeometry x="65" y="1380" width="280" height="130" as="geometry"/>
        </mxCell>

        <!-- Branding API -->
        <mxCell id="branding-api" value="&lt;b&gt;📡 API Branding&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Validación Zod: AgencyBrandingUpdateSchema&lt;br&gt;&lt;br&gt;Guarda en tenant.brandingConfig:&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;logoUrl: string | null,&lt;br&gt;&amp;nbsp;&amp;nbsp;primaryColor: string | null,&lt;br&gt;&amp;nbsp;&amp;nbsp;showPoweredBy: boolean,&lt;br&gt;&amp;nbsp;&amp;nbsp;customFooterText: string | null&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;arcSize=8;fontSize=10;fontColor=#0c4a6e;" parent="1" vertex="1">
          <mxGeometry x="400" y="1380" width="300" height="130" as="geometry"/>
        </mxCell>

        <!-- Branding Inheritance -->
        <mxCell id="branding-inherit" value="&lt;b&gt;⬇️ Herencia a Slots&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Al crear slot:&lt;br&gt;brandingConfig: agency?.brandingConfig || {}&lt;br&gt;&lt;br&gt;Cada slot BUSINESS recibe:&lt;br&gt;• Mismo logo y colores&lt;br&gt;• Config showPoweredBy&lt;br&gt;• Footer personalizado&lt;br&gt;&lt;br&gt;&lt;i&gt;⚠️ Solo el AGENCY puede cambiar branding.&lt;br&gt;Los slots lo heredan al crearse.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;arcSize=8;fontSize=10;fontColor=#0c4a6e;" parent="1" vertex="1">
          <mxGeometry x="760" y="1380" width="370" height="130" as="geometry"/>
        </mxCell>

        <!-- Arrows branding -->
        <mxCell id="arrow-brand1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0284c7;strokeWidth=2;endArrow=blockThin;endFill=1;" parent="1" source="branding-ui" target="branding-api" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow-brand2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0284c7;strokeWidth=2;endArrow=blockThin;endFill=1;" parent="1" source="branding-api" target="branding-inherit" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="&lt;b&gt;Leyenda de Colores&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;🟣 Tenants AGENCY&lt;/b&gt; — Cuentas padre que gestionan slots&lt;br&gt;&lt;b&gt;🟢 Slots / Sub-tenants&lt;/b&gt; — Clientes aprovisionados por la agencia&lt;br&gt;&lt;b&gt;🔴 Tenants BUSINESS&lt;/b&gt; — Clientes directos (no slots)&lt;br&gt;&lt;b&gt;🟡 Procesos&lt;/b&gt; — Lógica de activación de módulos&lt;br&gt;&lt;b&gt;🔵 Marca Blanca&lt;/b&gt; — Branding y personalización&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#e5e7eb;arcSize=8;fontSize=10;fontColor=#374151;" parent="1" vertex="1">
          <mxGeometry x="40" y="1540" width="1120" height="50" as="geometry"/>
