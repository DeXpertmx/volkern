    "test:e2e": "bash scripts/run-e2e-all.sh",
    "turbo:clean": "rm -rf .turbo node_modules/.cache/turbo",
    "fix-finanzas-orden": "npx tsx scripts/fix-finanzas-orden.ts",
    "openapi:generate": "tsx scripts/generate-openapi.mjs",
    "generate-partner-docs": "tsx scripts/generate-partner-api-docs.ts"
