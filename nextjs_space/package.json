{
  "name": "app",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:docs": "bash scripts/check-docs-no-cjk.sh",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' npx tsc --noEmit --project tsconfig.check.json",
    "prebuild": "npm run openapi:generate",
    "prepare": "husky || true",
    "postinstall": "patch-package",
    "test:bash": "bash tests/fence-states.test.sh",
