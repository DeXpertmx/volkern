{
  "expo": {
    "owner": "dexpertmx",
    "name": "Gemma",
    "slug": "gemma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "gemma",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.volkern.gemma",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Gemma usa el micrófono para comandos de voz",
        "NSPhotoLibraryUsageDescription": "Gemma necesita acceso a tu galería para compartir imágenes",
        "NSPhotoLibraryAddUsageDescription": "Gemma puede guardar archivos en tu galería"
      }
    },
    "android": {
      "package": "com.volkern.gemma",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gemma necesita acceso a tu galería para compartir imágenes."
        }
      ]
    ],
    "extra": {
      "router": {},
      "apiUrl": "http://localhost:3000",
      "eas": {
        "projectId": "baaeb27f-3dd4-4b25-b0c9-e4654c7547cb"
      }
    }
  }
}
