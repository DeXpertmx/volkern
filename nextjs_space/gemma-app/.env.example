# ─── Gemma App — Variables de Entorno ──────────────────────────────────────
# Copia este archivo como .env y ajusta según tu entorno.
# Las variables EXPO_PUBLIC_ se inyectan en el bundle al compilar.

# URL base del servidor Volkern
# En producción: https://volkern.app
# En desarrollo local: http://localhost:3000 (o IP local)
EXPO_PUBLIC_API_URL=https://volkern.app
