# =============================================
# Volkern Auditor — Variables de Entorno
# Renombrar a .env antes de ejecutar
# =============================================

# Base de datos PostgreSQL del ERP Volkern
DB_NAME=volkern_local
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# Notificaciones Telegram (opcional)
# Crear bot en: https://t.me/BotFather
TELEGRAM_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# URL del Backoffice (para el link en la notificación)
BACKOFFICE_URL=http://localhost:3000

# Umbrales de sesgo (valores por defecto: 0.05 y 0.10)
# CV > CV_THRESHOLD_YELLOW → Alerta AMARILLA
# CV > CV_THRESHOLD_RED    → Kill Switch automático + Alerta ROJA
CV_THRESHOLD_YELLOW=0.05
CV_THRESHOLD_RED=0.10
