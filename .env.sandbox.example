# Live Smoke Test — Real Meta + Google Sandbox Credentials
#
# Copy this file to `.env.sandbox` (which is covered by the root `.env*`
# rule in `.gitignore`, so it will never be committed) and fill out with
# your real sandbox credentials from Meta + Google.
#
# The script `nextjs_space/scripts/smoke-ads-live-credentials.ts` will:
#   1. Wipe any stale sandbox records (sandbox-account scoped).
#   2. Provision `AdPlatformConnection` via VaultService.encrypt(...).
#   3. Create `AdsCreative` + `AdsCampaignPublication`.
#   4. Call the production `connector.publishPublication` (real HTTPS).
#   5. Assert: `externalAdId` populated + `estado` mapped (PUBLICADA/PROGRAMADA).
#   6. Call `connector.syncInsights` — confirms metrics endpoint reachable.
#   7. Cleanup records.
#
# The script SKIPs with exit 0 when ANY platform has missing creds, so CI
# can run it unconditionally without breaking. If creds are present and
# assertions fail, exit 1.
#
# !!! DO NOT commit `.env.sandbox`. The `.env*` rule in the root
# `.gitignore` keeps it out of git.

# ─── Meta Ads (Graph API v22.0) ───────────────────────────────────────
# Meta app credentials from https://developers.facebook.com/apps
ADS_META_CLIENT_ID=
ADS_META_CLIENT_SECRET=

# Sandbox page + adset used for new-platform ads
ADS_META_DEFAULT_PAGE_ID=
ADS_META_DEFAULT_ADSET_ID=

# Sandbox long-lived access token (60-day TTL).
# Obtain via OAuth flow with ads_management + ads_read scopes.
META_SANDBOX_ACCESS_TOKEN=
META_SANDBOX_ACCOUNT_ID=
# Optional: refresh token used by MetaAdsConnector.refreshTokenIfNeeded for auto-renewal.
META_SANDBOX_REFRESH_TOKEN=

# Smoke creative overrides (must be a public URL that Meta can fetch).
META_SANDBOX_IMAGE_URL=https://placehold.co/1200x630.png
META_SANDBOX_HEADLINE=Live Smoke Headline
META_SANDBOX_BODY=Live smoke body — Meta
META_SANDBOX_LANDING_URL=https://example.com

# ─── Google Ads (REST v16 + GAQL) ─────────────────────────────────────
# Google OAuth app + developer token from https://console.cloud.google.com
ADS_GOOGLE_CLIENT_ID=
ADS_GOOGLE_CLIENT_SECRET=
ADS_GOOGLE_DEVELOPER_TOKEN=

# Sandbox customer + ad group (from your Google Ads manager account)
GOOGLE_SANDBOX_CUSTOMER_ID=
GOOGLE_SANDBOX_AD_GROUP_ID=
# Refresh token (OAuth flow with access_type=offline gives long-lived refresh)
GOOGLE_SANDBOX_REFRESH_TOKEN=

# Smoke creative overrides (must be a public URL Google can fetch).
GOOGLE_SANDBOX_IMAGE_URL=https://placehold.co/1200x630.png
GOOGLE_SANDBOX_HEADLINE=Live Smoke Headline
GOOGLE_SANDBOX_BODY=Live smoke body — Google
GOOGLE_SANDBOX_LANDING_URL=https://example.com
